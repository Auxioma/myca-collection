<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="payment_services_order_sync">
        <job name="sync_order_payment_status" instance="Magento\PaymentServicesPaypal\Cron\SyncOrderPaymentStatus" method="execute">
            <schedule>*/10 * * * *</schedule>
        </job>
    </group>
    <group id="payment_services_metadata_sync">
        <job name="sync_payment_services_metadata"
             instance="Magento\PaymentServicesPaypal\Cron\SyncAPSMetadata"
             method="execute">
            <schedule>0 2 * * 0</schedule>
        </job>
    </group>
</config>
