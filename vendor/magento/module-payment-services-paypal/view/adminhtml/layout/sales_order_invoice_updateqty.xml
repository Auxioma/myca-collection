<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="order_items">
            <block class="Magento\PaymentServicesPaypal\Block\Adminhtml\Order\Invoice\Create\CustomCapture"
                   name="paymentservicespaypal.invoice.custom_capture.updateqty"
                   as="submit_before"
                   template="Magento_PaymentServicesPaypal::order/invoice/create/custom_capture.phtml"/>
        </referenceBlock>
        <referenceBlock name="invoice_totals">
            <block class="Magento\PaymentServicesPaypal\Block\Adminhtml\Order\Invoice\Totals\CustomCapture"
                   name="paymentservicespaypal.invoice.custom_capture_total.updateqty"
                   after="tax"/>
        </referenceBlock>
    </body>
</page>
