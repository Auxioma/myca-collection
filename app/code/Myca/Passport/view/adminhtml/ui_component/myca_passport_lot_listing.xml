<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">myca_passport_lot_listing.myca_passport_lot_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/edit"/>
                <class>primary</class>
                <label translate="true">Nouveau lot</label>
            </button>
        </buttons>
        <spinner>myca_passport_lot_columns</spinner>
        <deps>
            <dep>myca_passport_lot_listing.myca_passport_lot_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="myca_passport_lot_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">lot_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Myca_Passport::passport</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="myca_passport_lot_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>lot_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="myca_passport_lot_columns">
        <column name="lot_code" sortOrder="10">
            <settings>
                <filter>text</filter>
                <label translate="true">Lot</label>
            </settings>
        </column>
        <column name="product_id" sortOrder="20">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID produit</label>
            </settings>
        </column>
        <column name="collection" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Collection</label>
            </settings>
        </column>
        <column name="model_reference" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Référence modèle</label>
            </settings>
        </column>
        <column name="manufactured_on" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Fabrication</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="60">
            <settings>
                <dataType>date</dataType>
                <label translate="true">Créé le</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <actionsColumn name="actions" class="Myca\Passport\Ui\Component\Listing\Column\Actions" sortOrder="100">
            <settings>
                <indexField>lot_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
