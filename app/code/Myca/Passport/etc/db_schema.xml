<?xml version="1.0"?>
<!--
    Passeport du vêtement (M50). Un lot de fabrication porte les données du vêtement, chacune avec son statut
    (certifiée, déclarée, en cours de validation). Chaque passeport a un identifiant aléatoire, jamais supprimé :
    un ancien QR reste résolu (passeport actif, révoqué ou remplacé). Corrections et révocations sont tracées.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="myca_passport_lot" resource="default" engine="innodb" comment="MYCA - Lots de fabrication">
        <column xsi:type="int" name="lot_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="lot_code" length="64" nullable="false"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false" comment="Modèle (produit parent)"/>
        <column xsi:type="varchar" name="model_reference" length="64" nullable="true"/>
        <column xsi:type="varchar" name="collection" length="128" nullable="true"/>
        <column xsi:type="varchar" name="cut" length="128" nullable="true"/>
        <column xsi:type="varchar" name="material" length="255" nullable="true"/>
        <column xsi:type="varchar" name="grammage" length="64" nullable="true"/>
        <column xsi:type="varchar" name="origin" length="128" nullable="true"/>
        <column xsi:type="varchar" name="manufactured_on" length="7" nullable="true" comment="AAAA-MM"/>
        <column xsi:type="text" name="field_status" nullable="false" comment="JSON : champ → certified, declared, pending"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="lot_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MYCA_PASSPORT_LOT_LOT_CODE">
            <column name="lot_code"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_PASSPORT_LOT_PRODUCT_ID_CATALOG_PRODUCT_ENTITY_ENTITY_ID"
                    table="myca_passport_lot" column="product_id" referenceTable="catalog_product_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>

    <table name="myca_passport" resource="default" engine="innodb" comment="MYCA - Passeports du vêtement">
        <column xsi:type="int" name="passport_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="token" length="32" nullable="false" comment="Identifiant aléatoire, URL du QR et n° d'authenticité"/>
        <column xsi:type="int" name="lot_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false" comment="Variante"/>
        <column xsi:type="varchar" name="variant_label" length="255" nullable="true" comment="Couleur, taille"/>
        <column xsi:type="varchar" name="serial_number" length="64" nullable="true" comment="Passeport à l'unité"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="active" comment="active, revoked"/>
        <column xsi:type="varchar" name="revoked_reason" length="255" nullable="true"/>
        <column xsi:type="int" name="replaced_by_id" unsigned="true" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="revoked_at" nullable="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="passport_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MYCA_PASSPORT_TOKEN">
            <column name="token"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_PASSPORT_LOT_ID_MYCA_PASSPORT_LOT_LOT_ID"
                    table="myca_passport" column="lot_id" referenceTable="myca_passport_lot" referenceColumn="lot_id" onDelete="CASCADE"/>
        <index referenceId="MYCA_PASSPORT_SERIAL_NUMBER" indexType="btree">
            <column name="serial_number"/>
        </index>
        <index referenceId="MYCA_PASSPORT_LOT_ID_SKU" indexType="btree">
            <column name="lot_id"/>
            <column name="sku"/>
        </index>
    </table>

    <table name="myca_passport_history" resource="default" engine="innodb" comment="MYCA - Corrections et révocations tracées">
        <column xsi:type="int" name="history_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="lot_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="passport_id" unsigned="true" nullable="true"/>
        <column xsi:type="varchar" name="action" length="16" nullable="false" comment="create, correct, generate, revoke, replace"/>
        <column xsi:type="varchar" name="field" length="64" nullable="true"/>
        <column xsi:type="text" name="old_value" nullable="true"/>
        <column xsi:type="text" name="new_value" nullable="true"/>
        <column xsi:type="varchar" name="reason" length="255" nullable="true"/>
        <column xsi:type="varchar" name="author" length="255" nullable="false"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="history_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_PASSPORT_HISTORY_LOT_ID_MYCA_PASSPORT_LOT_LOT_ID"
                    table="myca_passport_history" column="lot_id" referenceTable="myca_passport_lot" referenceColumn="lot_id" onDelete="CASCADE"/>
    </table>

    <table name="myca_passport_scan" resource="default" engine="innodb" comment="MYCA - Consultations (empreinte anonyme)">
        <column xsi:type="bigint" name="scan_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="passport_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="visitor_hash" length="64" nullable="false" comment="HMAC de l'adresse IP : aucune IP stockée"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="scan_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_PASSPORT_SCAN_PASSPORT_ID_MYCA_PASSPORT_PASSPORT_ID"
                    table="myca_passport_scan" column="passport_id" referenceTable="myca_passport" referenceColumn="passport_id" onDelete="CASCADE"/>
        <index referenceId="MYCA_PASSPORT_SCAN_PASSPORT_ID_CREATED_AT" indexType="btree">
            <column name="passport_id"/>
            <column name="created_at"/>
        </index>
    </table>

    <table name="myca_passport_owner" resource="default" engine="innodb" comment="MYCA - Passeports enregistrés par les clients">
        <column xsi:type="int" name="passport_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="passport_id"/>
            <column name="customer_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_PASSPORT_OWNER_PASSPORT_ID_MYCA_PASSPORT_PASSPORT_ID"
                    table="myca_passport_owner" column="passport_id" referenceTable="myca_passport" referenceColumn="passport_id" onDelete="CASCADE"/>
        <constraint xsi:type="foreign" referenceId="MYCA_PASSPORT_OWNER_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="myca_passport_owner" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
    </table>
</schema>
