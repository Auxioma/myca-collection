<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:App/etc/routes.xsd">
    <router id="standard">
        <!-- Portail client (achats MYCA en ligne) : /retours -->
        <route id="retours" frontName="retours">
            <module name="Myca_Rma"/>
        </route>
        <!-- Portail partenaire : /partenaire/retours (contrôleurs Controller/Retours). Après Myca_Partner, qui garde ses propres pages. -->
        <route id="partenaire">
            <module name="Myca_Rma" after="Myca_Partner"/>
        </route>
    </router>
</config>
