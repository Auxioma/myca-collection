<?xml version="1.0"?>
<!-- Journal d'audit : consultation seule (aucune action de masse, aucune modification). -->
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">myca_audit_log_listing.myca_audit_log_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <spinner>myca_audit_log_listing_columns</spinner>
        <deps>
            <dep>myca_audit_log_listing.myca_audit_log_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="myca_audit_log_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">log_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Myca_Core::audit</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="myca_audit_log_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>log_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="myca_audit_log_listing_columns">
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="10">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Date</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="actor_type" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Auteur (type)</label>
            </settings>
        </column>
        <column name="actor_name" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Auteur</label>
            </settings>
        </column>
        <column name="action" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Action</label>
            </settings>
        </column>
        <column name="entity_type" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Objet</label>
            </settings>
        </column>
        <column name="entity_id" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Identifiant</label>
            </settings>
        </column>
        <column name="old_values" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">Avant</label>
            </settings>
        </column>
        <column name="new_values" sortOrder="80">
            <settings>
                <filter>text</filter>
                <label translate="true">Après</label>
            </settings>
        </column>
        <column name="comment" sortOrder="90">
            <settings>
                <filter>text</filter>
                <label translate="true">Commentaire</label>
            </settings>
        </column>
        <column name="ip" sortOrder="100">
            <settings>
                <filter>text</filter>
                <label translate="true">IP</label>
            </settings>
        </column>
    </columns>
</listing>
