<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="myca" translate="label" sortOrder="100">
            <label>MYCA</label>
        </tab>
        <section id="myca_core" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Identité visuelle</label>
            <tab>myca</tab>
            <resource>Myca_Core::config</resource>
            <group id="identity" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Identités</label>
                <field id="partner_groups" translate="label comment" type="multiselect" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Groupes clients « partenaire »</label>
                    <comment>Ces groupes reçoivent l’identité partenaire (accent rouge). Les autres clients connectés reçoivent l’identité client (accent or).</comment>
                    <source_model>Magento\Customer\Model\Customer\Source\Group</source_model>
                    <can_be_empty>1</can_be_empty>
                </field>
            </group>
        </section>
    </system>
</config>
