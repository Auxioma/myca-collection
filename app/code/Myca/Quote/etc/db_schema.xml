<?xml version="1.0"?>
<!--
    Devis clients (M30). Un devis proposé est figé dans un PDF versionné (chemin et empreinte sha256) ; l'acceptation
    ne crée ni commande ni facture : le client transforme le devis en panier aux prix convenus, puis paie.
-->
<schema xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Setup/Declaration/Schema/etc/schema.xsd">
    <table name="myca_quote" resource="default" engine="innodb" comment="MYCA - Devis">
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="varchar" name="increment_id" length="32" nullable="true" comment="DEV-AAAA-NNNN"/>
        <column xsi:type="int" name="customer_id" unsigned="true" nullable="false"/>
        <column xsi:type="smallint" name="store_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false" default="draft"/>
        <column xsi:type="text" name="customer_note" nullable="true" comment="Besoin exprimé : personnalisation, délais…"/>
        <column xsi:type="text" name="proposal_note" nullable="true" comment="Conditions proposées par MYCA"/>
        <column xsi:type="date" name="valid_until" nullable="true"/>
        <column xsi:type="smallint" name="version" unsigned="true" nullable="false" default="0" comment="Version du PDF proposé"/>
        <column xsi:type="decimal" name="subtotal_excl_tax" scale="4" precision="20" unsigned="false" nullable="true"/>
        <column xsi:type="decimal" name="tax_amount" scale="4" precision="20" unsigned="false" nullable="true"/>
        <column xsi:type="decimal" name="grand_total" scale="4" precision="20" unsigned="false" nullable="true"/>
        <column xsi:type="varchar" name="pdf_path" length="255" nullable="true"/>
        <column xsi:type="varchar" name="pdf_sha256" length="64" nullable="true"/>
        <column xsi:type="int" name="order_id" unsigned="true" nullable="true"/>
        <column xsi:type="varchar" name="order_increment_id" length="50" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <column xsi:type="timestamp" name="updated_at" nullable="false" default="CURRENT_TIMESTAMP" on_update="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="quote_id"/>
        </constraint>
        <constraint xsi:type="unique" referenceId="MYCA_QUOTE_INCREMENT_ID">
            <column name="increment_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_QUOTE_CUSTOMER_ID_CUSTOMER_ENTITY_ENTITY_ID"
                    table="myca_quote" column="customer_id" referenceTable="customer_entity" referenceColumn="entity_id" onDelete="CASCADE"/>
        <index referenceId="MYCA_QUOTE_CUSTOMER_ID_STATUS" indexType="btree">
            <column name="customer_id"/>
            <column name="status"/>
        </index>
    </table>

    <table name="myca_quote_item" resource="default" engine="innodb" comment="MYCA - Lignes de devis">
        <column xsi:type="int" name="item_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false"/>
        <column xsi:type="int" name="product_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="sku" length="64" nullable="false"/>
        <column xsi:type="varchar" name="name" length="255" nullable="false"/>
        <column xsi:type="text" name="buy_request" nullable="false" comment="Options choisies (taille, coloris), pour remettre l'article au panier"/>
        <column xsi:type="decimal" name="qty" scale="4" precision="12" unsigned="true" nullable="false"/>
        <column xsi:type="decimal" name="catalog_price" scale="4" precision="20" unsigned="true" nullable="false" comment="Prix TTC catalogue à la demande"/>
        <column xsi:type="decimal" name="unit_price_incl_tax" scale="4" precision="20" unsigned="true" nullable="true" comment="Prix TTC proposé"/>
        <column xsi:type="decimal" name="tax_percent" scale="4" precision="12" unsigned="true" nullable="true"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="item_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_QUOTE_ITEM_QUOTE_ID_MYCA_QUOTE_QUOTE_ID"
                    table="myca_quote_item" column="quote_id" referenceTable="myca_quote" referenceColumn="quote_id" onDelete="CASCADE"/>
    </table>

    <table name="myca_quote_history" resource="default" engine="innodb" comment="MYCA - Suivi des devis">
        <column xsi:type="int" name="history_id" unsigned="true" nullable="false" identity="true"/>
        <column xsi:type="int" name="quote_id" unsigned="true" nullable="false"/>
        <column xsi:type="varchar" name="status" length="16" nullable="false"/>
        <column xsi:type="varchar" name="author" length="255" nullable="false"/>
        <column xsi:type="text" name="message" nullable="true"/>
        <column xsi:type="timestamp" name="created_at" nullable="false" default="CURRENT_TIMESTAMP"/>
        <constraint xsi:type="primary" referenceId="PRIMARY">
            <column name="history_id"/>
        </constraint>
        <constraint xsi:type="foreign" referenceId="MYCA_QUOTE_HISTORY_QUOTE_ID_MYCA_QUOTE_QUOTE_ID"
                    table="myca_quote_history" column="quote_id" referenceTable="myca_quote" referenceColumn="quote_id" onDelete="CASCADE"/>
    </table>

    <!-- Panier issu d'un devis accepté : les prix convenus ne s'appliquent qu'à ses lignes. -->
    <table name="quote">
        <column xsi:type="int" name="myca_quote_id" unsigned="true" nullable="true" comment="Devis MYCA converti dans ce panier"/>
    </table>
</schema>
