<?php
/**
 * Section de cartes de catégories (P01) : titre serif, sous-titre, bouton facultatif, puis cartes.
 * « Type de produit » : image détourée 180 px, nom, nombre de modèles, « Voir les … ».
 * « Collection » : carte du thème Magento_Catalog::category/collection-card.phtml.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Myca\Catalog\Block\Widget\CategoryCards;

/** @var CategoryCards $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$categories = $block->getCategories();
if (!$categories) {
    return;
}

/** @var SvgIcons $icons */
$icons = $viewModels->require(SvgIcons::class);
$title = (string) $block->getData('title');
$subtitle = (string) $block->getData('subtitle');
$linkLabel = (string) $block->getData('link_label');
$linkUrl = (string) $block->getData('link_url');
$isCollection = $block->getStyle() === CategoryCards::STYLE_COLLECTION;
$headingId = 'myca-cards-' . substr(sha1($title . $block->getData('url_keys')), 0, 8);
?>
<section <?php if ($title !== ''): ?>aria-labelledby="<?= $escaper->escapeHtmlAttr($headingId) ?>"<?php endif ?>>
    <?php if ($title !== '' || $linkLabel !== ''): ?>
        <div class="mb-4 flex flex-col gap-3 sm:flex-row sm:items-start sm:gap-4">
            <div class="flex flex-1 flex-col gap-3">
                <?php if ($title !== ''): ?>
                    <h2 id="<?= $escaper->escapeHtmlAttr($headingId) ?>" class="myca-section-title"><?= $escaper->escapeHtml($title) ?></h2>
                <?php endif ?>
                <?php if ($subtitle !== ''): ?>
                    <p class="myca-body-m text-fg-secondary"><?= $escaper->escapeHtml($subtitle) ?></p>
                <?php endif ?>
            </div>
            <?php if ($linkLabel !== '' && $linkUrl !== ''): ?>
                <a href="<?= $escaper->escapeUrl($block->getUrl('', ['_direct' => ltrim($linkUrl, '/')])) ?>" class="myca-btn myca-btn-outline-accent self-start sm:min-w-[220px]">
                    <?= $icons->renderHtml('arrow-right', '', 16, 16, ['aria-hidden' => 'true']) ?>
                    <?= $escaper->escapeHtml($linkLabel) ?>
                </a>
            <?php endif ?>
        </div>
    <?php endif ?>

    <ul role="list" class="grid gap-4 <?= $isCollection ? 'sm:grid-cols-2 lg:grid-cols-3' : 'grid-cols-2 lg:grid-cols-4' ?>">
        <?php foreach ($categories as $category): ?>
            <li>
                <?php if ($isCollection): ?>
                    <?= /* @noEscape */ $block->renderCollectionCard($category) ?>
                <?php else: ?>
                    <?php
                    $count = $block->getProductCount($category);
                    $name = (string) $category->getName();
                    ?>
                    <article class="myca-card relative flex h-full flex-col overflow-hidden shadow-card transition-shadow hover:shadow-md">
                        <div class="flex h-32 items-center justify-center bg-surface md:h-[180px]">
                            <?php if ($category->getImage()): ?>
                                <img src="<?= $escaper->escapeUrl($category->getImageUrl()) ?>" alt="" class="max-h-full w-auto object-contain" loading="lazy" width="180" height="180">
                            <?php endif ?>
                        </div>
                        <div class="flex flex-1 flex-col items-start gap-1.5 p-3 md:p-4">
                            <h3 class="myca-h3 text-fg">
                                <a href="<?= $escaper->escapeUrl($category->getUrl()) ?>" class="after:absolute after:inset-0 focus-visible:outline-none focus-visible:after:rounded-lg focus-visible:after:outline-2 focus-visible:after:outline-accent">
                                    <?= $escaper->escapeHtml($name) ?>
                                </a>
                            </h3>
                            <p class="myca-body-s text-fg-secondary">
                                <?= $escaper->escapeHtml($count > 1 ? __('%1 modèles', $count) : __('%1 modèle', $count)) ?>
                            </p>
                            <p class="mt-auto inline-flex items-center gap-1 pt-1 myca-body-s-strong text-accent-text" aria-hidden="true">
                                <?= $escaper->escapeHtml(__('Voir les %1', mb_strtolower($name))) ?>
                                <?= $icons->renderHtml('arrow-right', '', 14, 14) ?>
                            </p>
                        </div>
                    </article>
                <?php endif ?>
            </li>
        <?php endforeach ?>
    </ul>
</section>
