<?php
/**
 * M51 — Plan du site : bannière puis huit cartes (accueil, collections, produits, marque, services, pages légales,
 * compte, contact). Catégories et pages CMS sont lues à chaque affichage : une page désactivée disparaît du plan.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Myca\Content\ViewModel\SiteMap;

/** @var Template $block */
/** @var Escaper $escaper */

/** @var SiteMap $siteMap */
$siteMap = $block->getData('view_model');
$pages = $siteMap->getPages();
$categories = $siteMap->getCategoryGroups();
$sections = [
    ['home', __('Accueil'), [['title' => (string) __('Page d’accueil'), 'url' => $block->getBaseUrl()]]],
    ['layers', __('Collections'), $categories['collections']],
    ['shirt', __('Produits'), $categories['products']],
    ['crown', __('La Marque'), $pages['brand']],
    ['headset', __('Services'), [...$pages['service'], ...$siteMap->getServices()]],
    ['file', __('Informations légales'), $pages['legal']],
    ['user', __('Mon compte'), $siteMap->getAccountLinks()],
    ['mail', __('Contact'), $siteMap->getContactLinks()],
];
?>
<div class="myca-rx-hero mb-5">
    <figure><img src="<?= $escaper->escapeUrl($siteMap->getHeroImageUrl()) ?>" alt="" width="1140" height="520"></figure>
    <div class="myca-rx-hero-text myca-sm-hero-text">
        <h1><?= $escaper->escapeHtml(__('Plan du site')) ?></h1>
        <p><?= $escaper->escapeHtml(__('Accédez rapidement à toutes les pages de l’univers MYCA.')) ?></p>
    </div>
</div>
<div class="myca-sm-grid">
    <?php foreach ($sections as [$icon, $title, $links]): ?>
        <?php if ($links === []) { continue; } ?>
        <nav class="myca-sm-card" aria-label="<?= $escaper->escapeHtmlAttr($title) ?>">
            <h2>
                <span class="myca-sm-icon myca-pb-icon-<?= $escaper->escapeHtmlAttr($icon) ?>" aria-hidden="true"></span>
                <?= $escaper->escapeHtml($title) ?>
            </h2>
            <ul>
                <?php foreach ($links as $link): ?>
                    <li class="<?= ((int) ($link['level'] ?? 0)) > 0 ? 'ps-4' : '' ?>">
                        <a href="<?= $escaper->escapeUrl($link['url']) ?>"><?= $escaper->escapeHtml($link['title']) ?></a>
                    </li>
                <?php endforeach ?>
            </ul>
        </nav>
    <?php endforeach ?>
</div>
