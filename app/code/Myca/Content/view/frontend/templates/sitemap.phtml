<?php
/**
 * M51 — Plan du site : catégories, pages de service, compte et pages légales réellement publiées.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Myca\Content\ViewModel\SiteMap;

/** @var Template $block */
/** @var Escaper $escaper */

/** @var SiteMap $siteMap */
$siteMap = $block->getData('view_model');
$pages = $siteMap->getPages();
$sections = [
    [__('Boutique'), array_map(static fn (array $c) => ['title' => $c['name'], 'url' => $c['url'], 'level' => $c['level']], $siteMap->getCategories())],
    [__('Informations & aide'), $pages['service']],
    [__('Mon compte & services'), $siteMap->getServices()],
    [__('Informations légales'), $pages['legal']],
];
?>
<div class="mx-auto grid w-full max-w-[1200px] gap-6 py-4 md:grid-cols-2 lg:grid-cols-4">
    <?php foreach ($sections as [$title, $links]): ?>
        <?php if ($links === []) { continue; } ?>
        <nav aria-label="<?= $escaper->escapeHtmlAttr($title) ?>">
            <h2 class="mb-2 text-base font-semibold text-fg"><?= $escaper->escapeHtml($title) ?></h2>
            <ul class="flex flex-col gap-1 myca-body-s">
                <?php foreach ($links as $link): ?>
                    <li class="<?= ((int) ($link['level'] ?? 0)) > 0 ? 'pl-4' : '' ?>">
                        <a href="<?= $escaper->escapeUrl($link['url']) ?>" class="inline-block py-1 text-fg underline-offset-2 hover:underline focus-visible:underline">
                            <?= $escaper->escapeHtml($link['title']) ?>
                        </a>
                    </li>
                <?php endforeach ?>
            </ul>
        </nav>
    <?php endforeach ?>
</div>
