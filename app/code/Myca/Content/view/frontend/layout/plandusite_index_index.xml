<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.main.title">
            <action method="setPageTitle">
                <argument name="title" xsi:type="string" translate="true">Plan du site</argument>
            </action>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="myca.sitemap" template="Myca_Content::sitemap.phtml">
                <arguments>
                    <argument name="view_model" xsi:type="object">Myca\Content\ViewModel\SiteMap</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
