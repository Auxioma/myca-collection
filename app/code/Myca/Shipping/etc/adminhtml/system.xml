<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="myca_shipping" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
            <label>Livraison</label>
            <tab>myca</tab>
            <resource>Myca_Shipping::config</resource>
            <group id="relay" translate="label" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Point relais offert</label>
                <field id="free_threshold" translate="label comment" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Seuil (€ TTC, après remise)</label>
                    <comment>Calculé sur les produits éligibles, remises déduites, hors frais de livraison.</comment>
                    <validate>required-entry validate-zero-or-greater</validate>
                </field>
                <field id="carriers" translate="label comment" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Transporteurs « point relais »</label>
                    <comment>Codes des modules transporteurs, séparés par des virgules (ex. mondialrelay,colissimo_pickup).</comment>
                </field>
            </group>
            <group id="destinations" translate="label" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="0">
                <label>Destinations desservies</label>
                <field id="list" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Pays</label>
                    <comment>Une commande vers un pays absent de cette liste est refusée.</comment>
                    <frontend_model>Myca\Shipping\Block\Adminhtml\Form\Field\Destinations</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
            </group>
        </section>
        <section id="carriers">
            <group id="mycahome" translate="label" sortOrder="5" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>MYCA – Livraison à domicile</label>
                <field id="active" translate="label" type="select" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="0" canRestore="1">
                    <label>Activé</label>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="title" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Nom du transporteur</label>
                </field>
                <field id="name" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Nom du mode de livraison</label>
                </field>
                <field id="rates" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Barème</label>
                    <frontend_model>Myca\Shipping\Block\Adminhtml\Form\Field\HomeRates</frontend_model>
                    <backend_model>Magento\Config\Model\Config\Backend\Serialized\ArraySerialized</backend_model>
                </field>
                <field id="sort_order" translate="label" type="text" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="0">
                    <label>Ordre d'affichage</label>
                </field>
            </group>
        </section>
    </system>
</config>
