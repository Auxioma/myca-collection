<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <job name="myca_loyalty_validate" instance="Myca\Loyalty\Cron\ValidatePending" method="execute">
            <schedule>15 * * * *</schedule>
        </job>
        <job name="myca_loyalty_expire" instance="Myca\Loyalty\Cron\ExpireInactive" method="execute">
            <schedule>30 3 * * *</schedule>
        </job>
    </group>
</config>
