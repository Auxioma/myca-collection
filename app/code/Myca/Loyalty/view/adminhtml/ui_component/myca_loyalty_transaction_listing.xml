<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">myca_loyalty_transaction_listing.myca_loyalty_transaction_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="adjust">
                <url path="*/*/adjust"/>
                <class>primary</class>
                <label translate="true">Ajuster un solde</label>
            </button>
        </buttons>
        <spinner>myca_loyalty_transaction_columns</spinner>
        <deps>
            <dep>myca_loyalty_transaction_listing.myca_loyalty_transaction_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="myca_loyalty_transaction_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">transaction_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Myca_Loyalty::loyalty</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="myca_loyalty_transaction_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>transaction_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="myca_loyalty_transaction_columns">
        <column name="transaction_id" sortOrder="10">
            <settings>
                <filter>textRange</filter>
                <label translate="true">N°</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="20">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Date</label>
            </settings>
        </column>
        <column name="customer_id" sortOrder="30">
            <settings>
                <filter>textRange</filter>
                <label translate="true">ID client</label>
            </settings>
        </column>
        <column name="event" component="Magento_Ui/js/grid/columns/select" sortOrder="40">
            <settings>
                <options class="Myca\Loyalty\Model\Source\Event"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Événement</label>
            </settings>
        </column>
        <column name="order_increment_id" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Commande</label>
            </settings>
        </column>
        <column name="reason" sortOrder="60">
            <settings>
                <filter>text</filter>
                <label translate="true">Motif</label>
            </settings>
        </column>
        <column name="pending_delta" sortOrder="70">
            <settings>
                <label translate="true">En attente (±)</label>
            </settings>
        </column>
        <column name="available_delta" sortOrder="80">
            <settings>
                <label translate="true">Utilisables (±)</label>
            </settings>
        </column>
        <column name="available_after" sortOrder="90">
            <settings>
                <label translate="true">Solde utilisable après</label>
            </settings>
        </column>
        <column name="author" sortOrder="100">
            <settings>
                <filter>text</filter>
                <label translate="true">Auteur</label>
            </settings>
        </column>
    </columns>
</listing>
