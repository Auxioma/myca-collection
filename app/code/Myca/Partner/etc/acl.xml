<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Customer::customer">
                    <resource id="Myca_Partner::partners" title="Partenaires B2B" translate="title" sortOrder="50">
                        <resource id="Myca_Partner::manage" title="Créer, modifier, gérer les comptes" translate="title" sortOrder="10"/>
                        <resource id="Myca_Partner::status" title="Activer, suspendre" translate="title" sortOrder="20"/>
                        <resource id="Myca_Partner::applications" title="Candidatures (accepter, refuser)" translate="title" sortOrder="30"/>
                    </resource>
                </resource>
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Myca_Partner::config" title="MYCA - Espace partenaire" translate="title"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
