<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="myca_partner" translate="label" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Espace partenaire</label>
            <tab>myca</tab>
            <resource>Myca_Partner::config</resource>
            <group id="contact" translate="label comment" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Service Partenaire B2B</label>
                <comment>Coordonnées affichées dans le pied de page de l’espace partenaire. À confirmer avant mise en ligne.</comment>
                <field id="hours" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Horaires</label>
                </field>
                <field id="phone" translate="label" type="text" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>Téléphone</label>
                </field>
                <field id="email" translate="label" type="text" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1" canRestore="1">
                    <label>E-mail</label>
                    <validate>validate-email</validate>
                </field>
            </group>
        </section>
    </system>
</config>
