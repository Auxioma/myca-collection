<?xml version="1.0"?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">myca_partner_listing.myca_partner_listing_data_source</item>
        </item>
    </argument>
    <settings>
        <buttons>
            <button name="add">
                <url path="*/*/edit"/>
                <class>primary</class>
                <label translate="true">Nouveau partenaire</label>
            </button>
        </buttons>
        <spinner>myca_partner_listing_columns</spinner>
        <deps>
            <dep>myca_partner_listing.myca_partner_listing_data_source</dep>
        </deps>
    </settings>
    <dataSource name="myca_partner_listing_data_source" component="Magento_Ui/js/grid/provider">
        <settings>
            <storageConfig>
                <param name="indexField" xsi:type="string">partner_id</param>
            </storageConfig>
            <updateUrl path="mui/index/render"/>
        </settings>
        <aclResource>Myca_Partner::partners</aclResource>
        <dataProvider class="Magento\Framework\View\Element\UiComponent\DataProvider\DataProvider" name="myca_partner_listing_data_source">
            <settings>
                <requestFieldName>id</requestFieldName>
                <primaryFieldName>partner_id</primaryFieldName>
            </settings>
        </dataProvider>
    </dataSource>
    <listingToolbar name="listing_top">
        <settings>
            <sticky>true</sticky>
        </settings>
        <bookmark name="bookmarks"/>
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="myca_partner_listing_columns">
        <column name="code" sortOrder="10">
            <settings>
                <filter>text</filter>
                <label translate="true">N° partenaire</label>
            </settings>
        </column>
        <column name="company_name" sortOrder="20">
            <settings>
                <filter>text</filter>
                <label translate="true">Partenaire / boutique</label>
            </settings>
        </column>
        <column name="city" sortOrder="30">
            <settings>
                <filter>text</filter>
                <label translate="true">Ville</label>
            </settings>
        </column>
        <column name="country_id" sortOrder="40">
            <settings>
                <filter>text</filter>
                <label translate="true">Pays</label>
            </settings>
        </column>
        <column name="sales_modes" sortOrder="50">
            <settings>
                <filter>text</filter>
                <label translate="true">Modes de vente</label>
            </settings>
        </column>
        <column name="status" component="Magento_Ui/js/grid/columns/select" sortOrder="60">
            <settings>
                <options class="Myca\Partner\Model\Source\PartnerStatus"/>
                <filter>select</filter>
                <dataType>select</dataType>
                <label translate="true">Statut</label>
            </settings>
        </column>
        <column name="email" sortOrder="70">
            <settings>
                <filter>text</filter>
                <label translate="true">E-mail</label>
            </settings>
        </column>
        <column name="created_at" class="Magento\Ui\Component\Listing\Columns\Date" component="Magento_Ui/js/grid/columns/date" sortOrder="80">
            <settings>
                <filter>dateRange</filter>
                <dataType>date</dataType>
                <label translate="true">Créé le</label>
                <sorting>desc</sorting>
            </settings>
        </column>
        <actionsColumn name="actions" class="Myca\Partner\Ui\Component\Listing\Column\Actions" sortOrder="200">
            <argument name="data" xsi:type="array">
                <item name="editUrl" xsi:type="string">myca_partner/partner/edit</item>
            </argument>
            <settings>
                <indexField>partner_id</indexField>
            </settings>
        </actionsColumn>
    </columns>
</listing>
