<?php
/**
 * Colonne d'information de la fiche produit (M45) : collection, titre, accroche, prix, avis, description courte,
 * choix couleur / taille, disponibilité, achat + favori, tuiles de réassurance.
 * Mobile : le bouton d'achat reste visible en bas d'écran (règle responsive de theme.md).
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\ProductPage;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Catalog\Model\Product;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

/** @var ProductPage $productViewModel */
$productViewModel = $viewModels->require(ProductPage::class);
/** @var SvgIcons $icons */
$icons = $viewModels->require(SvgIcons::class);

/** @var Product $product */
$product = $productViewModel->getProduct();
$collection = (string) $product->getAttributeText('myca_collection');
$tagline = (string) $product->getData('myca_tagline');
// Macaron « MYCA Signature » : seulement pour les produits de la ligne Signature
$isSignature = (bool) $product->getCategoryCollection()->addAttributeToFilter('url_key', 'myca-signature')->getSize();

$tiles = [
    ['truck', __('Point relais offert'), __('dès 100 € TTC*')],
    ['box', __('Rétractation'), __('14 jours')],
    ['shield-check', __('Paiement'), __('sécurisé')],
    ['crown', __('Qualité'), __('premium')],
];
?>
<div class="product-info-main flex flex-col items-start gap-3.5">
    <div class="flex w-full items-start justify-between gap-4">
        <div class="flex min-w-0 flex-col items-start gap-3">
            <?php if ($collection !== ''): ?>
                <p class="rounded-md bg-brand-red px-3 py-1 text-sm leading-5 font-semibold text-white"><?= $escaper->escapeHtml(__('Collection %1', $collection)) ?></p>
            <?php endif ?>

            <h1 class="font-display text-[32px] leading-10 font-semibold text-navy-900 md:text-[40px] md:leading-12">
                <?= $escaper->escapeHtml($product->getName()) ?>
            </h1>

            <?php if ($tagline !== ''): ?>
                <p class="text-base leading-6 text-fg-secondary md:text-lg"><?= $escaper->escapeHtml($tagline) ?></p>
            <?php endif ?>
        </div>
        <?php if ($isSignature): ?>
            <p class="myca-pdp-signature" aria-label="<?= $escaper->escapeHtmlAttr(__('Ligne MYCA Signature')) ?>">
                <?= $icons->renderHtml('crown', 'text-gold-500', 26, 26, ['aria-hidden' => 'true']) ?>
                <span class="font-logo text-lg leading-none text-navy-900">MYCA<sup class="text-[8px]">®</sup></span>
                <span class="font-display text-lg leading-none font-semibold text-gold-700 italic"><?= $escaper->escapeHtml(__('Signature')) ?></span>
            </p>
        <?php endif ?>
    </div>

    <div class="text-navy-900 [--price-font-size:34px] [--price-font-weight:700]" role="group" aria-label="<?= $escaper->escapeHtmlAttr(__('Prix')) ?>">
        <?= $block->getChildHtml('product.info.price') ?>
    </div>

    <?= $block->getChildHtml('product.info.review') ?>

    <?php if ($shortDescription = $productViewModel->getShortDescription()): ?>
        <div class="myca-body-m text-fg"><?= /* @noEscape */ $shortDescription ?></div>
    <?php endif ?>

    <hr class="w-full border-line">

    <div class="myca-pdp-options w-full">
        <?= $block->getChildHtml('product.info.form') ?>
    </div>

    <?= $block->getChildHtml('product.info.stockstatus') ?>
    <?= $block->getChildHtml('alert.urls') ?>

    <?php if ($product->isSaleable()): ?>
        <div class="myca-pdp-buy myca-above-nav fixed inset-x-0 bottom-0 z-20 flex w-full gap-3 border-t border-line bg-surface p-3 md:static md:border-0 md:p-0">
            <div class="flex-1"><?= $block->getChildHtml('product.info.addtocart') ?></div>
            <?= $block->getChildHtml('product.info.addtowishlist') ?>
        </div>
        <?php if ($shortcuts = $block->getChildHtml('addtocart.shortcut.buttons')): ?>
            <div class="flex w-full flex-wrap gap-2"><?= /* @noEscape */ $shortcuts ?></div>
        <?php endif ?>
    <?php endif ?>

    <ul class="myca-pdp-perks" aria-label="<?= $escaper->escapeHtmlAttr(__('Nos engagements')) ?>">
        <?php foreach ($tiles as [$icon, $title, $text]): ?>
            <li>
                <?= $icons->renderHtml($icon, 'text-gold-700', 30, 30, ['aria-hidden' => 'true']) ?>
                <span class="text-sm leading-5 font-semibold text-navy-900"><?= $escaper->escapeHtml($title) ?></span>
                <span class="text-xs leading-4 text-fg-secondary"><?= $escaper->escapeHtml($text) ?></span>
            </li>
        <?php endforeach ?>
    </ul>

    <?php if ($tierPriceBlock = $block->getChildHtml('product.price.tier')): ?>
        <div class="tier-price-container w-full"><?= /** @noEscape */ $tierPriceBlock ?></div>
    <?php endif ?>

    <?= $block->getChildHtml('product.info.additional') ?>
</div>
