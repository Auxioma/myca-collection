            <button
                type="button"
                role="tab"
                id="myca-tab-<?= $escaper->escapeHtmlAttr($key) ?>"
                class="myca-tab"
                aria-controls="myca-panel-<?= $escaper->escapeHtmlAttr($key) ?>"
                data-tab="<?= $escaper->escapeHtmlAttr($key) ?>"
                :aria-selected="active === '<?= $escaper->escapeJs($key) ?>'"
                :tabindex="active === '<?= $escaper->escapeJs($key) ?>' ? 0 : -1"
                @click="select('<?= $escaper->escapeJs($key) ?>')"
            ><?= $escaper->escapeHtml($label) ?></button>
        <?php endforeach ?>
    </div>

    <div id="myca-panel-description" role="tabpanel" aria-labelledby="myca-tab-description" tabindex="0"
         class="grid items-start gap-6 pt-5 <?= $detailImage ? 'lg:grid-cols-[minmax(0,1fr)_220px_minmax(0,315px)]' : 'lg:grid-cols-[minmax(0,1fr)_minmax(0,315px)]' ?>" x-show="active === 'description'">
        <div>
            <h2 class="mb-3 font-display text-2xl leading-8 font-semibold text-navy-900">
                <?= $escaper->escapeHtml($collection !== ''
                    ? __('Le %1 – Collection %2', $product->getName(), $collection)
                    : $product->getName()) ?>
            </h2>
            <div class="myca-body-m text-fg-secondary">
                <?= /* @noEscape */ $outputHelper->productAttribute($product, $description, 'description') ?>
            </div>
        </div>
        <?php if ($detailImage): ?>
            <img src="<?= $escaper->escapeUrl($detailImage->getData('medium_image_url') ?: $detailImage->getData('url')) ?>"
                 alt="<?= $escaper->escapeHtmlAttr($detailImage->getData('label') ?: $product->getName()) ?>"
                 class="hidden aspect-[4/3] w-full rounded-xl object-cover lg:block" width="220" height="165" loading="lazy">
        <?php endif ?>
        <button type="button" class="myca-pdp-passport-card" @click="select('passport')">
            <span class="flex size-16 shrink-0 items-center justify-center rounded-lg bg-gradient-to-br from-gold-500 to-gold-700 text-white shadow-card">
                <?= $icons->renderHtml('book', '', 30, 30, ['aria-hidden' => 'true']) ?>
            </span>
            <span class="flex-1">
                <span class="block font-display text-lg leading-6 font-semibold text-navy-900"><?= $escaper->escapeHtml(__('Passeport du vêtement')) ?></span>
                <span class="block text-sm leading-5 text-fg-secondary"><?= $escaper->escapeHtml(__('& certificat d’authenticité')) ?></span>
            </span>
            <span class="flex size-8 shrink-0 items-center justify-center rounded-full bg-gold-700 text-white">
                <?= $icons->renderHtml('chevron-right', '', 16, 16, ['aria-hidden' => 'true']) ?>
            </span>
        </button>
    </div>

    <div id="myca-panel-passport" role="tabpanel" aria-labelledby="myca-tab-passport" tabindex="0"
         class="pt-4" x-show="active === 'passport'" x-cloak>
        <div class="max-w-2xl myca-body-m text-fg-secondary">
            <p>
                <?= $escaper->escapeHtml(__(
                    'Chaque pièce MYCA est accompagnée d’un passeport numérique, consultable par QR code : origine, '
                    . 'contrôles qualité et certificat d’authenticité.'
                )) ?>
            </p>
            <a href="<?= $escaper->escapeUrl($block->getUrl('', ['_direct' => 'passeport'])) ?>" class="mt-3 inline-flex items-center gap-1 myca-body-s-strong text-accent-text hover:underline">
                <?= $escaper->escapeHtml(__('Découvrir le passeport du vêtement')) ?>
                <?= $icons->renderHtml('arrow-right', '', 14, 14, ['aria-hidden' => 'true']) ?>
            </a>
        </div>
    </div>

    <?php if ($materials !== '' || $hasCareData): ?>
        <div id="myca-panel-materials" role="tabpanel" aria-labelledby="myca-tab-materials" tabindex="0"
             class="pt-5" x-show="active === 'materials'" x-cloak>
            <?php if (!$hasCareData): ?>
                <div class="max-w-2xl myca-body-m text-fg-secondary">
                    <?= /* @noEscape */ $outputHelper->productAttribute($product, $materials, 'myca_materials') ?>
