            <?php else: ?>
                <?php
                $fabric = $materialsCare->getFabric($product);
                $specs = $materialsCare->getSpecs($product);
                $care = $materialsCare->getCare($product);
                $tips = $materialsCare->getTips($product);
                ?>
                <div class="grid items-start gap-5 lg:grid-cols-2">
                    <section class="myca-mc-card" aria-labelledby="myca-mc-materials">
                        <h3 id="myca-mc-materials" class="myca-mc-head">
                            <span><?= $icons->renderHtml('layers', '', 26, 26, ['aria-hidden' => 'true']) ?></span>
                            <?= $escaper->escapeHtml(__('Matières & qualité')) ?>
                        </h3>
                        <?php if ($fabric['title'] !== ''): ?>
                            <div class="grid gap-4 p-4 sm:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] sm:items-center">
                                <div class="myca-mc-fabric" aria-hidden="true"></div>
                                <div>
                                    <p class="font-display text-xl leading-7 font-semibold text-navy-900"><?= $escaper->escapeHtml($fabric['title']) ?></p>
                                    <?php if ($fabric['description'] !== ''): ?>
                                        <p class="mt-1.5 text-sm leading-6 text-fg-secondary"><?= $escaper->escapeHtml($fabric['description']) ?></p>
                                    <?php endif ?>
                                </div>
                            </div>
                        <?php endif ?>
                        <?php if ($specs !== []): ?>
                            <dl class="myca-mc-specs">
                                <?php foreach ($specs as $spec): ?>
                                    <div>
                                        <dt><?= $icons->renderHtml($spec['icon'], 'shrink-0 text-navy-900', 22, 22, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml($spec['label']) ?></dt>
                                        <dd><?= $escaper->escapeHtml($spec['value']) ?></dd>
                                    </div>
                                <?php endforeach ?>
                            </dl>
                        <?php endif ?>
                    </section>

                    <div class="flex flex-col gap-5">
                        <?php if ($care !== []): ?>
                            <section class="myca-mc-card" aria-labelledby="myca-mc-care">
                                <h3 id="myca-mc-care" class="myca-mc-head">
                                    <span><?= $icons->renderHtml('care-wash-30', '', 26, 26, ['aria-hidden' => 'true']) ?></span>
                                    <?= $escaper->escapeHtml(__('Entretien – conseils de lavage')) ?>
                                </h3>
                                <ul class="myca-mc-care">
                                    <?php foreach ($care as $instruction): ?>
                                        <li>
                                            <?= $icons->renderHtml($instruction['icon'], 'shrink-0 text-navy-900', 34, 34, ['aria-hidden' => 'true']) ?>
                                            <span><?= $escaper->escapeHtml($instruction['label']) ?></span>
                                        </li>
                                    <?php endforeach ?>
                                </ul>
                            </section>
                        <?php endif ?>
                        <?php if ($tips !== []): ?>
                            <section class="myca-mc-tips" aria-labelledby="myca-mc-tips">
                                <h3 id="myca-mc-tips"><?= $escaper->escapeHtml(__('Nos conseils MYCA')) ?></h3>
                                <ul>
                                    <?php foreach ($tips as $tip): ?>
                                        <li><?= $icons->renderHtml('check', 'mt-0.5 shrink-0 text-gold-700', 18, 18, ['aria-hidden' => 'true']) ?><span><?= $escaper->escapeHtml($tip) ?></span></li>
                                    <?php endforeach ?>
                                </ul>
                            </section>
                        <?php endif ?>
                    </div>
                </div>
            <?php endif ?>
        </div>
    <?php endif ?>
</section>
<script>
    function initMycaProductTabs() {
        return {
            active: 'description',
            init() {
                // Lien direct vers un onglet (#myca-tab-materials depuis le passeport)
                const tab = window.location.hash.replace('#myca-tab-', '');
                if (tab && this.$root.querySelector(`[role="tab"][data-tab="${CSS.escape(tab)}"]`)) {
                    this.active = tab;
                }
            },
            select(tab) {
                this.active = tab;
            },
            move(step) {
                const tabs = Array.from(this.$root.querySelectorAll('[role="tab"]'));
                const index = tabs.findIndex(tab => tab.dataset.tab === this.active);
                const next = tabs[(index + step + tabs.length) % tabs.length];
                this.select(next.dataset.tab);
                next.focus();
            }
        }
    }

    window.addEventListener('alpine:init', () => Alpine.data('initMycaProductTabs', initMycaProductTabs), { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
