<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="myca_partner_space"/>
    <body>
        <referenceBlock name="myca.partner.banner">
            <arguments>
                <argument name="kicker" xsi:type="string" translate="true">PASSER UNE COMMANDE</argument>
                <argument name="title" xsi:type="string" translate="true">Passer une commande</argument>
                <argument name="subtitle" xsi:type="string" translate="true">Composez votre commande parmi les collections MYCA et bénéficiez de vos tarifs partenaires.</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="myca.partner.page" template="Myca_Dropship::order-form.phtml" after="myca.partner.banner">
                <arguments>
                    <argument name="view_model" xsi:type="object">Myca\Dropship\ViewModel\OrderForm</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
