                <div class="flex justify-between"><dt><?= $escaper->escapeHtml(__('Total produits HT')) ?></dt><dd x-text="money(state.totals.subtotal_excl_tax)"></dd></div>
                <div class="flex justify-between"><dt><?= $escaper->escapeHtml(__('Livraison professionnelle')) ?></dt>
