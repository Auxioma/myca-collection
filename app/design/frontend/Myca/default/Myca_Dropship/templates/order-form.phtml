                <div class="mt-1 flex justify-between rounded-lg bg-gold-100 px-3 py-2 text-base font-semibold"><dt><?= $escaper->escapeHtml(__('Total TTC')) ?></dt><dd x-text="money(state.totals.grand_total)"></dd></div>
            </dl>
            <div class="mt-3 flex flex-col gap-2">
                <button type="button" class="myca-btn myca-btn-primary w-full" :disabled="state.lines.length === 0" @click="step = step < 3 ? 3 : 4">
