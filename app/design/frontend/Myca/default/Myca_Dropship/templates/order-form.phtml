<script>
    function mycaPartnerOrder(config) {
        const money = new Intl.NumberFormat('fr-FR', {style: 'currency', currency: 'EUR'});
        return {
            models: config.models,
            state: config.state,
            conditions: config.conditions,
            urls: config.urls,
            step: 1,
            filters: {collection: '', category: '', availability: 'stock', q: ''},
            selectedId: null,
            colorId: null,
            quantities: {},
            busy: false,
            submitting: false,
            message: null,
            recipient: Object.assign({firstname: '', lastname: '', street: '', postcode: '', city: '', country_id: 'FR', telephone: ''}, config.state.recipient || {}),
            declared: config.state.declared_sale_amount ?? '',
            payment: '',
            terms: false,
            init() {
                if (location.hash === '#validation') {
                    this.step = 4;
                }
                if (this.state.payment_methods.length === 1) {
                    this.payment = this.state.payment_methods[0].code;
                }
            },
            money(value) {
                return money.format(value || 0);
            },
            get collections() {
                return [...new Set(this.models.map((m) => m.collection).filter(Boolean))].sort();
            },
            get categories() {
                return [...new Set(this.models.map((m) => m.category).filter(Boolean))].sort();
            },
            get visibleModels() {
                const q = this.filters.q.trim().toLowerCase();
                return this.models.filter((m) => (!this.filters.collection || m.collection === this.filters.collection)
                    && (!this.filters.category || m.category === this.filters.category)
                    && (this.filters.availability !== 'stock' || m.available > 0)
                    && (!q || (m.name + ' ' + m.sku + ' ' + m.collection).toLowerCase().includes(q)));
            },
            get selected() {
                return this.models.find((m) => m.id === this.selectedId) || null;
            },
            get selectedTotal() {
                return Object.values(this.quantities).reduce((sum, qty) => sum + (parseInt(qty, 10) || 0), 0);
            },
            get discount() {
                const contract = this.conditions.contract[this.state.mode];
                if (contract !== null && contract !== undefined) {
                    return contract;
                }
                if (this.state.mode === 'dropship') {
                    return this.conditions.dropship;
                }
                const tiers = this.conditions.stock_tiers.slice().sort((a, b) => a.min_qty - b.min_qty);
                return tiers.length && tiers[0].min_qty <= 1 ? tiers[0].discount : 0;
            },
            partnerPrice(model) {
                return model.public_price_excl_tax * (1 - this.discount / 100);
            },
            stockFor(sizeId) {
                const byColor = this.selected && this.selected.stock[this.colorId];
                return byColor && byColor[sizeId] !== undefined ? byColor[sizeId] : 0;
            },
            select(model) {
                this.selectedId = model.id;
                const firstAvailable = model.colors.find((c) => Object.values(model.stock[c.id] || {}).some((q) => q > 0));
                this.colorId = (firstAvailable || model.colors[0]).id;
                this.quantities = {};
                this.step = 2;
                this.$nextTick(() => this.$refs.quantities && this.$refs.quantities.scrollIntoView({behavior: 'smooth', block: 'start'}));
            },
            async post(url, payload) {
                this.busy = true;
                this.message = null;
                const body = new URLSearchParams({form_key: hyva.getFormKey()});
                const append = (key, value) => {
                    if (value !== null && typeof value === 'object') {
                        Object.entries(value).forEach(([k, v]) => append(key + '[' + k + ']', v));
                    } else {
                        body.append(key, value ?? '');
                    }
                };
                Object.entries(payload).forEach(([key, value]) => append(key, value));
                try {
                    const response = await fetch(url, {method: 'POST', body, credentials: 'same-origin', headers: {'X-Requested-With': 'XMLHttpRequest'}});
                    const json = await response.json();
                    if (json.state) {
                        this.state = json.state;
                    }
                    if (json.message) {
                        this.message = {type: json.ok ? 'success' : 'error', text: json.message};
                    }
                    return json.ok;
                } catch (e) {
                    this.message = {type: 'error', text: '<?= $escaper->escapeJs(__('Connexion interrompue : réessayez.')) ?>'};
                    return false;
                } finally {
                    this.busy = false;
                }
            },
            setMode(mode) {
                return mode !== this.state.mode ? this.post(this.urls.mode, {mode}) : Promise.resolve(true);
            },
            async add() {
                if (await this.post(this.urls.ajouter, {product_id: this.selectedId, color_id: this.colorId, sizes: this.quantities})) {
                    this.quantities = {};
                }
            },
            remove(line) {
                this.post(this.urls.retirer, {product_id: line.product_id, color_id: line.color_id});
            },
            async saveDelivery() {
                if (await this.post(this.urls.livraison, {recipient: this.recipient, declared_sale_amount: this.declared})) {
                    this.step = 4;
                }
            }
        };
    }
</script>
