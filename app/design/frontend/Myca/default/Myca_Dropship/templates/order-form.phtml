            <p class="myca-caption text-fg-secondary" x-text="state.mode === 'stock' ? '<?= $escaper->escapeJs(__('Achat de stock — livraison à la boutique')) ?>' : '<?= $escaper->escapeJs(__('Dropshipping — expédition au client final')) ?>'"></p>
            <ul class="mt-2 flex flex-col divide-y divide-line">
                <template x-for="line in state.lines" :key="line.product_id + '-' + line.color_id">
                    <li class="flex items-start justify-between gap-2 py-2">
                        <div class="min-w-0">
                            <p class="myca-body-s-strong" x-text="line.name"></p>
