<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- « Mon programme fidélité » (M36), affiché seulement quand le programme est activé. -->
        <referenceBlock name="customer_account_navigation">
            <block class="Magento\Customer\Block\Account\SortLink" name="customer-account-navigation-myca-loyalty-link"
                   ifconfig="myca_loyalty/program/enabled">
                <arguments>
                    <argument name="path" xsi:type="string">fidelite</argument>
                    <argument name="label" xsi:type="string" translate="true">Mon programme fidélité</argument>
                    <argument name="sortOrder" xsi:type="number">185</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
