<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="customer_account"/>
    <body>
        <referenceBlock name="myca.account.banner">
            <arguments>
                <argument name="title" xsi:type="string" translate="true">Mon programme fidélité</argument>
                <argument name="subtitle" xsi:type="string" translate="true">Cumulez des points sur vos achats éligibles et transformez-les en remises sur vos prochaines commandes.</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="myca.loyalty.program" template="Myca_Loyalty::program.phtml" after="myca.account.banner" cacheable="false"/>
        </referenceContainer>
    </body>
</page>
