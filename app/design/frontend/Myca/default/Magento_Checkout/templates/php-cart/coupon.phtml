<?php
/**
 * Carte « Code promo » (P06) : champ + « Appliquer », ou code appliqué + « Retirer ».
 * Envoi par hyva.postCart : le panier est mis à jour sans recharger la page.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\ReCaptcha;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Checkout\Block\Cart\Coupon;
use Magento\Framework\Escaper;

/** @var Coupon $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */
/** @var HyvaCsp $hyvaCsp */

$icons = $viewModels->require(SvgIcons::class);
$couponCode = (string) $block->getCouponCode();
// strlen : un code « 0 » est un code valide
$hasCouponCode = strlen($couponCode) > 0;
/** @var ReCaptcha|null $recaptcha */
$recaptcha = $block->getData('viewModelRecaptcha');
?>
<section class="myca-card p-4" aria-labelledby="myca-coupon-title" x-data="initMycaCouponForm">
    <h2 id="myca-coupon-title" class="mb-3 flex items-center gap-2 text-[15px] leading-5 font-semibold text-fg">
        <?= $icons->renderHtml('tag', 'text-gold-700', 18, 18, ['aria-hidden' => 'true']) ?>
        <?= $escaper->escapeHtml(__('Code promo')) ?>
    </h2>
    <form
        id="discount-coupon-form"
        action="<?= $escaper->escapeUrl($block->getUrl('checkout/cart/couponPost')) ?>"
        method="post"
        @submit.prevent="submitForm"
    >
        <?= $block->getBlockHtml('formkey') ?>
        <div class="flex gap-3">
            <label class="flex-1">
                <span class="sr-only"><?= $escaper->escapeHtml(__('Code promo')) ?></span>
                <input
                    type="text"
                    id="coupon_code"
                    name="coupon_code"
                    class="myca-field"
                    value="<?= $escaper->escapeHtmlAttr($couponCode) ?>"
                    placeholder="<?= $escaper->escapeHtmlAttr(__('Votre code')) ?>"
                    autocomplete="off"
                    <?= $hasCouponCode ? 'readonly' : 'required' ?>
                >
            </label>
            <?php if ($hasCouponCode): ?>
                <input type="hidden" name="remove" value="1">
                <button type="submit" class="myca-btn myca-btn-secondary"><?= $escaper->escapeHtml(__('Retirer')) ?></button>
            <?php else: ?>
                <button type="submit" class="myca-btn myca-btn-secondary"><?= $escaper->escapeHtml(__('Appliquer')) ?></button>
            <?php endif ?>
        </div>
        <?= $recaptcha ? $recaptcha->getInputHtml(ReCaptcha::RECAPTCHA_FORM_ID_COUPON_CODE) : '' ?>
        <?php if ($hasCouponCode): ?>
            <p class="mt-3 myca-badge myca-badge-success" role="status">
                <?= $escaper->escapeHtml(__('Code appliqué : %1', $couponCode)) ?>
            </p>
        <?php endif ?>
    </form>
    <?php if ($recaptcha): ?>
        <?= $recaptcha->getLegalNoticeHtml(ReCaptcha::RECAPTCHA_FORM_ID_COUPON_CODE) ?>
    <?php endif ?>
</section>
<script>
    function initMycaCouponForm() {
        return {
            errors: 0,
            submitForm() {
                const $form = document.querySelector('#discount-coupon-form');
                <?= $recaptcha ? $recaptcha->getValidationJsHtml(ReCaptcha::RECAPTCHA_FORM_ID_COUPON_CODE) : '' ?>
                if (this.errors === 0) {
                    hyva.postCart($form);
                }
            }
        };
    }

    window.addEventListener('alpine:init', () => Alpine.data('initMycaCouponForm', initMycaCouponForm), { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
