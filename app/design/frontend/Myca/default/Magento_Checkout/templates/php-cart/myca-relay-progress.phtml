<?php
/**
 * Progression vers le point relais offert (P06) : barre, puis « atteint » ou « Plus que X € ».
 * Règle calculée par Myca_Shipping (produits éligibles, après remise, hors livraison).
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\Pricing\Helper\Data as PriceHelper;
use Magento\Framework\View\Element\Template;
use Myca\Shipping\ViewModel\FreeRelayProgress;

// phpcs:disable Magento2.Templates.ThisInTemplate.FoundHelper

/** @var Template $block */
/** @var Escaper $escaper */

/** @var FreeRelayProgress $progressViewModel */
$progressViewModel = $block->getData('progress');
$progress = $progressViewModel->get();
if ($progress['threshold'] <= 0) {
    return;
}
/** @var PriceHelper $priceHelper */
$priceHelper = $this->helper(PriceHelper::class);
$format = static fn (float $amount): string => strip_tags((string) $priceHelper->currency($amount, true, false));
?>
<div class="mt-3 flex flex-col gap-2">
    <div class="flex items-center gap-3 myca-caption text-fg">
        <span><?= $escaper->escapeHtml(__('Relais offert')) ?></span>
        <div
            class="h-2 flex-1 overflow-hidden rounded-pill bg-surface-page"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="<?= (int) $progress['percent'] ?>"
            aria-label="<?= $escaper->escapeHtmlAttr(__('Progression vers le point relais offert')) ?>"
        >
            <div class="h-full rounded-pill <?= $progress['reached'] ? 'bg-green-600' : 'bg-amber-500' ?>" style="width: <?= (int) $progress['percent'] ?>%"></div>
        </div>
        <span class="myca-caption-strong"><?= $escaper->escapeHtml($progress['reached'] ? __('atteint') : $progress['percent'] . ' %') ?></span>
    </div>
    <p class="myca-caption <?= $progress['reached'] ? 'text-fg-secondary' : 'text-warning' ?>" role="status">
        <?php if ($progress['reached']): ?>
            <?= $escaper->escapeHtml(__(
                '%1 après remise ≥ %2 : point relais offert vers les destinations desservies.',
                $format($progress['eligible']),
                $format($progress['threshold'])
            )) ?>
        <?php else: ?>
            <?= $escaper->escapeHtml(__(
                'Plus que %1 pour profiter du point relais offert (dès %2 TTC après remise, destinations desservies).',
                $format($progress['remaining']),
                $format($progress['threshold'])
            )) ?>
        <?php endif ?>
    </p>
</div>
