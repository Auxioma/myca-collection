                        <button type="submit" class="myca-btn myca-btn-primary self-start"><?= $escaper->escapeHtml(__('Enregistrer mes prix')) ?></button>
                    <?php else: ?>
                        <p class="myca-caption text-fg-secondary"><?= $escaper->escapeHtml(__('Seul le titulaire du compte boutique peut modifier les prix de vente.')) ?></p>
                    <?php endif ?>
                </form>
            <?php else: ?>
                <p class="myca-body-s text-fg-secondary"><?= $escaper->escapeHtml(__('Vos modèles apparaîtront ici après votre première vente en dropshipping.')) ?></p>
            <?php endif ?>
        </section>
    <?php endif ?>

    <p class="flex gap-2 rounded-md bg-warning-bg p-3 myca-caption text-warning">
        <?= $icons->renderHtml('alert', 'mt-px shrink-0', 16, 16, ['aria-hidden' => 'true']) ?>
        <span>
            <?= $escaper->escapeHtml(__('Le chiffre d’affaires provient des prix de vente déclarés par la boutique (commandes en dropshipping). La marge affichée est une estimation après prix MYCA et frais de port — ce n’est ni la marge MYCA ni un bénéfice net certain.')) ?>
            <?php if ($margins->isPublicFallback()): ?>
                <?= $escaper->escapeHtml(__('Sans prix déclaré, le prix public conseillé sert d’estimation.')) ?>
            <?php endif ?>
        </span>
    </p>
</div>
