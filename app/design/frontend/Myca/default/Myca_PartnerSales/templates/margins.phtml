    <?php if ($view === 'ensemble'): ?>
        <?php
        $monthly = $margins->getMonthly();
        $max = max(1.0, ...array_values($monthly));
        $step = 10 ** (int) floor(log10($max));
        $axisMax = ceil($max / $step) * $step;
        [$w, $h, $left, $bottom, $top] = [420, 210, 64, 26, 12];
        $plotW = $w - $left - 10;
        $plotH = $h - $bottom - $top;
        $points = [];
        $index = 0;
        $count = count($monthly);
        foreach ($monthly as $month => $amount) {
            $x = $left + ($count > 1 ? $plotW * $index / ($count - 1) : $plotW / 2);
            $y = $top + $plotH * (1 - $amount / $axisMax);
            $points[] = ['x' => $x, 'y' => $y, 'month' => $month, 'amount' => $amount,
                'label' => (new IntlDateFormatter('fr_FR', IntlDateFormatter::NONE, IntlDateFormatter::NONE, null, null, 'MMM yyyy'))->format(strtotime($month . '-01'))];
            $index++;
        }
        $path = implode(' ', array_map(static fn (array $p) => round($p['x'], 1) . ',' . round($p['y'], 1), $points));
        $shares = array_slice($products, 0, 5);
        ?>
        <div class="grid gap-4 xl:grid-cols-3">
