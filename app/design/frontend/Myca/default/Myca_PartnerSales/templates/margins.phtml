                            <?php $gy = $top + $plotH * (1 - $ratio); ?>
                            <line x1="<?= (int) $left ?>" x2="<?= (int) ($w - 10) ?>" y1="<?= (float) round($gy, 1) ?>" y2="<?= (float) round($gy, 1) ?>" class="stroke-line" stroke-width="1"/>
                            <text x="<?= (int) ($left - 8) ?>" y="<?= (float) round($gy + 4, 1) ?>" text-anchor="end" class="fill-fg-muted text-[12px]"><?= $escaper->escapeHtml(number_format($axisMax * $ratio, 0, ',', "\u{202F}") . "\u{00A0}€") ?></text>
                        <?php endforeach ?>
                        <polygon points="<?= $escaper->escapeHtmlAttr(round($points[0]['x'], 1) . ',' . ($top + $plotH) . ' ' . $path . ' ' . round(end($points)['x'], 1) . ',' . ($top + $plotH)) ?>" class="fill-red-50"/>
                        <polyline points="<?= $escaper->escapeHtmlAttr($path) ?>" fill="none" class="stroke-accent" stroke-width="2" stroke-linejoin="round" stroke-linecap="round"/>
