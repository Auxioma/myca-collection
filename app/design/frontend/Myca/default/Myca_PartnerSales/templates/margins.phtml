        'variation' => $margins->variation((float) $current['revenue'], (float) $previous['revenue'])],
    ['icon' => 'coins', 'label' => __('Marge brute estimée'), 'value' => $margins->formatPrice((float) $current['margin']),
        'detail' => __('après prix MYCA et frais de port'), 'variation' => $margins->variation((float) $current['margin'], (float) $previous['margin'])],
    ['icon' => 'percent', 'label' => __('Taux de marge'), 'value' => $pct($current['rate']),
        'detail' => $rateDiff === null ? null : ($rateDiff >= 0 ? '+' : '−') . number_format(abs($rateDiff), 1, ',', '') . "\u{00A0}pts"],
    ['icon' => 'box', 'label' => __('Ventes (quantités)'), 'value' => __('%1 pcs', (float) $current['qty']),
