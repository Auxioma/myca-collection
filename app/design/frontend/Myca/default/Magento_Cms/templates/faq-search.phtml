<?php
/**
 * M46 — FAQ : une rubrique affichée à la fois (choisie dans la colonne de gauche ou par l'ancre de l'adresse,
 * ex. faq#paiement), recherche dans toutes les questions au fil de la saisie. Le contenu reste dans Page Builder ;
 * sans script, toutes les rubriques restent visibles.
 */

declare(strict_types=1);

use Hyva\Theme\ViewModel\HyvaCsp;
use Magento\Framework\Escaper;

/** @var Escaper $escaper */
/** @var HyvaCsp $hyvaCsp */
?>
<script>
    (() => {
        const init = () => {
            const groups = Array.from(document.querySelectorAll('[data-faq-group]'));
            const links = Array.from(document.querySelectorAll('[data-faq-link]'));
            const input = document.getElementById('myca-faq-search');
            const result = document.getElementById('myca-faq-result');
            if (!groups.length) {
                return;
            }
            const normalize = (text) => text.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
            const resolve = (hash) => {
                const key = (hash || '').replace('#', '');
                const group = groups.find((g) => g.id === key || (g.dataset.faqAlias || '') === key);
                return group ? group.id : groups[0].id;
            };
            let active = resolve(window.location.hash);

            const show = (openFirst) => {
                groups.forEach((group) => {
                    group.hidden = group.id !== active;
                    group.querySelectorAll('[data-faq-item]').forEach((item, index) => {
                        item.hidden = false;
                        if (openFirst) {
                            item.open = group.id === active && index === 0;
                        }
                    });
                });
                links.forEach((link) => {
                    const current = link.getAttribute('href') === '#' + active;
                    link.classList.toggle('is-active', current);
                    current ? link.setAttribute('aria-current', 'true') : link.removeAttribute('aria-current');
                });
            };

            const search = () => {
                const terms = normalize(input.value).split(/\s+/).filter(Boolean);
                if (!terms.length) {
                    result.textContent = '';
                    show(true);
                    return;
                }
                let total = 0;
                groups.forEach((group) => {
                    let visible = 0;
                    group.querySelectorAll('[data-faq-item]').forEach((item) => {
                        const match = terms.every((term) => normalize(item.textContent).includes(term));
                        item.hidden = !match;
                        item.open = match;
                        visible += match ? 1 : 0;
                    });
                    group.hidden = visible === 0;
                    total += visible;
                });
                links.forEach((link) => link.classList.remove('is-active'));
                result.textContent = total
                    ? total + ' <?= $escaper->escapeJs(__('réponse(s) trouvée(s)')) ?>'
                    : '<?= $escaper->escapeJs(__('Aucune réponse ne correspond : écrivez-nous depuis la page Contact.')) ?>';
            };

            links.forEach((link) => link.addEventListener('click', (event) => {
                event.preventDefault();
                if (input) {
                    input.value = '';
                    result.textContent = '';
                }
                active = resolve(link.getAttribute('href'));
                history.replaceState(null, '', '#' + active);
                show(true);
                if (window.matchMedia('(max-width: 1023px)').matches) {
                    document.getElementById(active).scrollIntoView({block: 'start'});
                }
            }));
            window.addEventListener('hashchange', () => {
                active = resolve(window.location.hash);
                show(true);
            });
            if (input) {
                let timer;
                input.addEventListener('input', () => {
                    clearTimeout(timer);
                    timer = setTimeout(search, 150);
                });
            }
            show(true);
        };
        document.readyState === 'loading' ? document.addEventListener('DOMContentLoaded', init) : init();
    })();
</script>
<?php $hyvaCsp->registerInlineScript() ?>
