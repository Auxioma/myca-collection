<?php
/**
 * M19 — Mes commandes (partenaire) : indicateurs, filtres par statut, recherche et période, tableau des commandes
 * de la boutique (tous ses utilisateurs), détail de la commande choisie, suivi et actions rapides.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Magento\Sales\Model\Order;
use Myca\Core\ViewModel\OrderProgress;
use Myca\Dropship\ViewModel\PartnerSales;
use Myca\Partner\ViewModel\PartnerSpace;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$icons = $viewModels->require(SvgIcons::class);
/** @var PartnerSpace $space */
$space = $viewModels->require(PartnerSpace::class);
/** @var PartnerSales $sales */
$sales = $viewModels->require(PartnerSales::class);
/** @var OrderProgress $progress */
$progress = $viewModels->require(OrderProgress::class);
$request = $block->getRequest();

$orders = $space->getOrders();
$filters = [
    'toutes' => ['layers', __('Toutes')],
    'preparation' => ['box', __('En préparation')],
    'expediees' => ['truck', __('En transit')],
    'livrees' => ['check-circle', __('Livrées')],
    'annulees' => ['refresh', __('Annulées')],
];
$labelsByFilter = [
    'preparation' => [(string) __('En préparation'), (string) __('En attente')],
    'expediees' => [(string) __('Expédiée')],
    'livrees' => [(string) __('Livrée')],
    'annulees' => [(string) __('Annulée'), (string) __('Remboursée')],
];
$matchesStatus = static function (Order $order, string $filter) use ($progress, $labelsByFilter): bool {
    return match ($filter) {
        'toutes' => true,
        'en-cours' => $progress->isInProgress($order),
        default => in_array($progress->getStatus($order)['label'], $labelsByFilter[$filter] ?? [], true),
    };
};
$periods = ['30' => __('30 derniers jours'), '90' => __('3 derniers mois'), '365' => __('12 derniers mois'), 'tout' => __('Toute la période')];

$status = (string) $request->getParam('statut', 'toutes');
$status = isset($filters[$status]) || $status === 'en-cours' ? $status : 'toutes';
$period = (string) $request->getParam('periode', 'tout');
$period = isset($periods[$period]) ? $period : 'tout';
$query = trim((string) $request->getParam('q'));

$since = $period === 'tout' ? 0 : strtotime('-' . (int) $period . ' days');
$matchesSearch = static function (Order $order) use ($query): bool {
    if ($query === '') {
        return true;
    }
    $haystack = [$order->getIncrementId(), $order->getShippingAddress()?->getName() ?? ''];
    foreach ($order->getAllVisibleItems() as $item) {
        $haystack[] = $item->getName();
        $haystack[] = $item->getSku();
    }

    return mb_stripos(implode(' ', $haystack), $query) !== false;
};
$inScope = array_values(array_filter(
    $orders,
    static fn (Order $order) => strtotime((string) $order->getCreatedAt()) >= $since && $matchesSearch($order)
));
$visible = array_values(array_filter($inScope, static fn (Order $order) => $matchesStatus($order, $status)));
$selected = $space->pickOrder($visible);
$baseQuery = array_filter(['q' => $query, 'periode' => $period === 'tout' ? null : $period]);

$count = static fn (string $filter) => count(array_filter($orders, static fn (Order $order) => $matchesStatus($order, $filter)));
$kpis = [
    ['icon' => 'cart', 'label' => __('Total commandes'), 'value' => (string) count($orders)],
    ['icon' => 'box', 'label' => __('En préparation'), 'value' => (string) $count('preparation')],
    ['icon' => 'truck', 'label' => __('En transit'), 'value' => (string) $count('expediees')],
    ['icon' => 'check-circle', 'label' => __('Livrées'), 'value' => (string) $count('livrees')],
];
$modeLabels = ['dropship' => __('Dropshipping'), 'stock' => __('Achat de stock')];
?>
