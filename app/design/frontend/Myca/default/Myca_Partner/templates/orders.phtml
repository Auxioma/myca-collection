                <li>
                    <a href="<?= $escaper->escapeUrl($block->getUrl('partenaire/commandes', ['_query' => $baseQuery + ($code === 'toutes' ? [] : ['statut' => $code])])) ?>"
                       class="myca-btn <?= $code === $status ? 'myca-btn-primary' : 'myca-btn-secondary' ?>"
                       <?= $code === $status ? 'aria-current="page"' : '' ?>>
                        <?= $icons->renderHtml($icon, '', 16, 16, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml($label) ?> (<?= (int) $n ?>)
                    </a>
                </li>
            <?php endforeach ?>
        </ul>
