<?php
/**
 * Interrupteur (Figma « Interrupteur ») : case à cocher native, présentée en bascule. Données : name, label, checked,
 * disabled.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$name = (string) $block->getData('name');
$id = 'myca-switch-' . preg_replace('/[^a-z0-9]+/i', '-', $name);
$disabled = (bool) $block->getData('disabled');
?>
<div class="flex min-h-11 items-center gap-3 border-b border-line py-2 last:border-b-0">
    <label for="<?= $escaper->escapeHtmlAttr($id) ?>" class="flex-1 myca-body-s text-fg"><?= $escaper->escapeHtml((string) $block->getData('label')) ?></label>
    <span class="relative inline-flex shrink-0">
        <input type="hidden" name="<?= $escaper->escapeHtmlAttr($name) ?>" value="0">
        <input
            id="<?= $escaper->escapeHtmlAttr($id) ?>"
            type="checkbox"
            role="switch"
            name="<?= $escaper->escapeHtmlAttr($name) ?>"
            value="1"
            class="peer absolute inset-0 z-10 size-full cursor-pointer opacity-0 disabled:cursor-not-allowed"
            <?= $block->getData('checked') ? 'checked' : '' ?>
            <?= $disabled ? 'disabled' : '' ?>
        >
        <span class="h-5 w-9 rounded-pill bg-gray-300 transition-colors peer-checked:bg-green-600 peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-accent peer-disabled:opacity-50" aria-hidden="true"></span>
        <span class="pointer-events-none absolute top-0.5 left-0.5 size-4 rounded-pill bg-white shadow transition-transform peer-checked:translate-x-4" aria-hidden="true"></span>
    </span>
</div>
