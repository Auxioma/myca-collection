        <section class="myca-card flex flex-col gap-3 p-4 shadow-card" aria-labelledby="myca-profile-presentation"
                 x-data="{ length: <?= (int) mb_strlen($field('description')) ?> }">
            <h2 id="myca-profile-presentation" class="myca-card-title mb-0"><?= $icons->renderHtml('file', 'text-accent-text', 18, 18, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Présentation de la boutique')) ?></h2>
            <label for="myca-description" class="sr-only"><?= $escaper->escapeHtml(__('Présentation de la boutique')) ?></label>
            <textarea id="myca-description" name="description" rows="6" maxlength="500" class="myca-field" aria-describedby="myca-description-count"
                      @input="length = $event.target.value.length" <?= /* @noEscape */ $readonly ?>><?= $escaper->escapeHtml($field('description')) ?></textarea>
            <p id="myca-description-count" class="text-right myca-caption text-fg-muted"><span x-text="length"><?= (int) mb_strlen($field('description')) ?></span> / 500 <?= $escaper->escapeHtml(__('caractères')) ?></p>
        </section>

        <section class="myca-card flex flex-col gap-3 p-4 shadow-card" aria-labelledby="myca-profile-commercial">
            <h2 id="myca-profile-commercial" class="myca-card-title mb-0"><?= $icons->renderHtml('cart', 'text-accent-text', 18, 18, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Informations commerciales')) ?></h2>
            <div class="grid gap-3 sm:grid-cols-2">
                <div>
                    <label for="myca-opening" class="myca-field-label"><?= $escaper->escapeHtml(__('Date d’ouverture')) ?></label>
                    <input id="myca-opening" name="opening_date" type="date" class="myca-field" value="<?= $escaper->escapeHtmlAttr($field('opening_date')) ?>" <?= /* @noEscape */ $readonly ?>>
                </div>
                <div>
                    <label for="myca-siret" class="myca-field-label"><?= $escaper->escapeHtml(__('SIRET / N° TVA')) ?></label>
                    <input id="myca-siret" class="myca-field" value="<?= $escaper->escapeHtmlAttr(trim($field('siret') . ' / ' . $field('vat_id'), ' /')) ?>" disabled aria-describedby="myca-siret-help">
                    <p id="myca-siret-help" class="mt-1 myca-caption text-fg-muted"><?= $escaper->escapeHtml(__('Vérifié par MYCA avant activation')) ?></p>
