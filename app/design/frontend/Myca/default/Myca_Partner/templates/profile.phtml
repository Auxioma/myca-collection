                <div class="sm:col-span-2">
                    <label for="myca-email" class="myca-field-label"><?= $escaper->escapeHtml(__('E-mail de la boutique')) ?></label>
                    <input id="myca-email" name="email" type="email" autocomplete="email" maxlength="255" class="myca-field" value="<?= $escaper->escapeHtmlAttr($field('email')) ?>" <?= /* @noEscape */ $readonly ?>>
