            <span class="h-2 flex-1 overflow-hidden rounded-pill bg-gray-200" role="progressbar" aria-labelledby="myca-profile-completion"
                  aria-valuemin="0" aria-valuemax="100" aria-valuenow="<?= (int) $percent ?>">
                <span class="block h-full rounded-pill bg-green-600" style="width: <?= (int) $percent ?>%"></span>
            </span>
            <span class="myca-body-s-strong text-fg"><?= (int) $percent ?> %</span>
        </div>
        <?php if ($canEdit): ?>
            <button type="submit" class="myca-btn myca-btn-primary md:min-h-11 md:px-5">
                <?= $icons->renderHtml('check', '', 16, 16, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Enregistrer les modifications')) ?>
            </button>
        <?php endif ?>
    </div>
</form>
