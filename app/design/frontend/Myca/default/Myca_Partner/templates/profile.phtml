            <label class="flex items-start gap-2 myca-body-s text-fg">
                <input type="hidden" name="show_in_directory" value="0">
                <input type="checkbox" name="show_in_directory" value="1" class="mt-0.5 size-4 rounded-sm accent-accent" <?= $field('show_in_directory') === '1' ? 'checked' : '' ?> <?= /* @noEscape */ $readonly ?>>
                <?= $escaper->escapeHtml(__('Afficher ma boutique sur le site MYCA (annuaire des partenaires)')) ?>
            </label>
        </section>

        <section class="myca-card flex flex-col p-4 shadow-card lg:col-span-2 2xl:col-span-1" aria-labelledby="myca-profile-settings">
            <h2 id="myca-profile-settings" class="myca-card-title"><?= $icons->renderHtml('settings', 'text-accent-text', 18, 18, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Paramètres de la boutique')) ?></h2>
            <?= /* @noEscape */ $switch('notify_new_collections', (string) __('Recevoir les nouvelles collections')) ?>
            <?= /* @noEscape */ $switch('notify_promotions', (string) __('Recevoir les promotions partenaires')) ?>
            <?= /* @noEscape */ $switch('allow_contact', (string) __('Être contacté par l’équipe MYCA')) ?>
            <?= /* @noEscape */ $switch('hide_contact_details', (string) __('Masquer mes coordonnées aux autres partenaires')) ?>
        </section>
