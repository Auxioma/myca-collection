                        <option value=""><?= $escaper->escapeHtml(__('Choisir…')) ?></option>
                        <?php foreach ($space->getCountryOptions() as $code => $name): ?>
                            <option value="<?= $escaper->escapeHtmlAttr($code) ?>" <?= $code === $field('country_id') ? 'selected' : '' ?>><?= $escaper->escapeHtml($name) ?></option>
                        <?php endforeach ?>
                    </select>
                </div>
                <div>
                    <label for="myca-phone" class="myca-field-label"><?= $escaper->escapeHtml(__('Téléphone')) ?></label>
                    <input id="myca-phone" name="phone" type="tel" autocomplete="tel" maxlength="32" class="myca-field" value="<?= $escaper->escapeHtmlAttr($field('phone')) ?>" <?= /* @noEscape */ $readonly ?>>
