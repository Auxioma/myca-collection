<?php
/**
 * M25 — Mon profil boutique : informations générales, logo, coordonnées, présentation, informations commerciales
 * et paramètres de la boutique. Modifiable par le titulaire du compte ; n° partenaire, statut, SIRET et TVA
 * restent contrôlés par MYCA.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Myca\Partner\Api\Data\PartnerInterface;
use Myca\Partner\ViewModel\PartnerSpace;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$icons = $viewModels->require(SvgIcons::class);
/** @var PartnerSpace $space */
$space = $viewModels->require(PartnerSpace::class);
$partner = $space->getPartner();
if ($partner === null) {
    return;
}
$canEdit = $space->isOwner();
$readonly = $canEdit ? '' : 'disabled';
$field = static fn (string $name) => $space->getField($name);
$logoUrl = $space->getLogoUrl();
$modes = $partner->getSalesModes();
$switch = function (string $name, string $label) use ($block, $field, $canEdit): string {
    return $block->getLayout()->createBlock(Template::class)->setTemplate('Myca_Partner::partials/switch.phtml')
        ->setData(['name' => $name, 'label' => $label, 'checked' => $field($name) === '1', 'disabled' => !$canEdit])
        ->toHtml();
};
$completion = ['company_name', 'description', 'street', 'postcode', 'city', 'country_id', 'phone', 'email', 'logo'];
$filled = count(array_filter($completion, static fn (string $name) => $field($name) !== ''));
$percent = (int) round($filled / count($completion) * 100);
?>
<form method="post" action="<?= $escaper->escapeUrl($block->getUrl('partenaire/profil/save')) ?>" class="flex flex-col gap-4">
    <?= $block->getBlockHtml('formkey') ?>
    <?php if (!$canEdit): ?>
        <p class="flex items-start gap-2 rounded-md bg-info-bg px-3 py-2.5 myca-caption text-info">
            <?= $icons->renderHtml('info', 'mt-px shrink-0', 16, 16, ['aria-hidden' => 'true']) ?>
            <?= $escaper->escapeHtml(__('Seul le titulaire du compte peut modifier le profil de la boutique.')) ?>
        </p>
    <?php endif ?>

    <div class="grid gap-4 xl:grid-cols-3">
        <section class="myca-card flex flex-col gap-3 p-4 shadow-card" aria-labelledby="myca-profile-general">
            <h2 id="myca-profile-general" class="myca-card-title mb-0"><?= $icons->renderHtml('store', 'text-accent-text', 18, 18, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Informations de la boutique')) ?></h2>
            <div>
                <label for="myca-company-name" class="myca-field-label"><?= $escaper->escapeHtml(__('Nom de la boutique *')) ?></label>
                <input id="myca-company-name" name="company_name" class="myca-field" required maxlength="255" value="<?= $escaper->escapeHtmlAttr($partner->getCompanyName()) ?>" <?= /* @noEscape */ $readonly ?>>
            </div>
            <div>
                <label for="myca-partner-code" class="myca-field-label"><?= $escaper->escapeHtml(__('N° de partenaire MYCA')) ?></label>
                <input id="myca-partner-code" class="myca-field" value="<?= $escaper->escapeHtmlAttr($partner->getCode()) ?>" disabled aria-describedby="myca-partner-code-help">
                <p id="myca-partner-code-help" class="mt-1 myca-caption text-fg-muted"><?= $escaper->escapeHtml(__('Identifiant contrôlé par MYCA')) ?></p>
            </div>
            <dl class="flex flex-col gap-2 myca-body-s">
                <div class="flex items-center justify-between"><dt class="text-fg-secondary"><?= $escaper->escapeHtml(__('Statut du compte')) ?></dt><dd class="myca-badge myca-badge-success"><?= $escaper->escapeHtml(__('Actif')) ?></dd></div>
                <div class="flex items-center justify-between"><dt class="text-fg-secondary"><?= $escaper->escapeHtml(__('Type de partenariat')) ?></dt><dd class="myca-badge myca-badge-premium"><?= $escaper->escapeHtml(__('Partenaire B2B')) ?></dd></div>
            </dl>
            <fieldset class="flex flex-col gap-1.5">
                <legend class="mb-1.5 myca-caption-strong text-fg"><?= $escaper->escapeHtml(__('Modes de vente (définis par MYCA)')) ?></legend>
                <?php foreach ([PartnerInterface::MODE_DROPSHIP => __('Dropshipping (sans stock)'), PartnerInterface::MODE_STOCK => __('Achat de stock (tarif grossiste)')] as $code => $label): ?>
                    <label class="flex items-center gap-2 myca-body-s text-fg">
                        <input type="checkbox" class="size-4 rounded-sm accent-accent" disabled <?= in_array($code, $modes, true) ? 'checked' : '' ?>>
                        <?= $escaper->escapeHtml($label) ?>
                    </label>
                <?php endforeach ?>
            </fieldset>
        </section>

        <section class="myca-card flex flex-col gap-3 p-4 shadow-card" aria-labelledby="myca-profile-logo">
            <h2 id="myca-profile-logo" class="myca-card-title mb-0"><?= $icons->renderHtml('file', 'text-accent-text', 18, 18, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Logo & identité')) ?></h2>
            <div class="flex items-center gap-4">
                <span class="flex size-[120px] shrink-0 items-center justify-center overflow-hidden rounded-lg bg-surface-subtle text-fg-muted">
                    <?php if ($logoUrl !== ''): ?>
                        <img src="<?= $escaper->escapeUrl($logoUrl) ?>" alt="<?= $escaper->escapeHtmlAttr(__('Logo de %1', $partner->getCompanyName())) ?>" class="size-full object-cover" width="120" height="120">
                    <?php else: ?>
                        <?= $icons->renderHtml('store', '', 40, 40, ['aria-hidden' => 'true']) ?>
                    <?php endif ?>
                </span>
                <p class="myca-caption text-fg-secondary"><?= $escaper->escapeHtml(__('Pour changer de logo ou de bannière, envoyez vos fichiers au Service Partenaire : l’équipe MYCA les valide avant publication.')) ?></p>
            </div>
        </section>

        <section class="myca-card flex flex-col gap-3 p-4 shadow-card" aria-labelledby="myca-profile-address">
            <h2 id="myca-profile-address" class="myca-card-title mb-0"><?= $icons->renderHtml('map-pin', 'text-accent-text', 18, 18, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Coordonnées & localisation')) ?></h2>
            <div class="grid gap-3 sm:grid-cols-2">
                <div class="sm:col-span-2">
                    <label for="myca-street" class="myca-field-label"><?= $escaper->escapeHtml(__('Adresse')) ?></label>
                    <input id="myca-street" name="street" autocomplete="street-address" maxlength="255" class="myca-field" value="<?= $escaper->escapeHtmlAttr($field('street')) ?>" <?= /* @noEscape */ $readonly ?>>
                </div>
                <div>
                    <label for="myca-postcode" class="myca-field-label"><?= $escaper->escapeHtml(__('Code postal')) ?></label>
                    <input id="myca-postcode" name="postcode" autocomplete="postal-code" maxlength="16" class="myca-field" value="<?= $escaper->escapeHtmlAttr($field('postcode')) ?>" <?= /* @noEscape */ $readonly ?>>
                </div>
                <div>
                    <label for="myca-city" class="myca-field-label"><?= $escaper->escapeHtml(__('Ville')) ?></label>
                    <input id="myca-city" name="city" autocomplete="address-level2" maxlength="128" class="myca-field" value="<?= $escaper->escapeHtmlAttr($field('city')) ?>" <?= /* @noEscape */ $readonly ?>>
                </div>
                <div>
                    <label for="myca-country" class="myca-field-label"><?= $escaper->escapeHtml(__('Pays')) ?></label>
