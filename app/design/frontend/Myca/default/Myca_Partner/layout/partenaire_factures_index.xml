<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="myca_partner_space"/>
    <body>
        <referenceBlock name="myca.partner.banner">
            <arguments>
                <argument name="kicker" xsi:type="string" translate="true">MES FACTURES</argument>
                <argument name="title" xsi:type="string" translate="true">Mes factures MYCA</argument>
                <argument name="subtitle" xsi:type="string" translate="true">Consultez et téléchargez les factures émises par MYCA à votre boutique.</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="myca.partner.page" template="Myca_Partner::invoices.phtml" after="myca.partner.banner"/>
        </referenceContainer>
    </body>
</page>
