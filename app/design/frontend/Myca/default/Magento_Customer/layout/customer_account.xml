<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Espace client M28–M39 : en-tête, menu, bandeau et pied de page dédiés (identité client). -->
        <referenceBlock name="header-content" template="Magento_Theme::html/header-account.phtml"/>
        <referenceBlock name="footer-content" template="Magento_Theme::html/footer-account.phtml">
            <block class="Magento\Theme\Block\Html\Header\Logo"
                   name="myca.account.footer.logo"
                   template="Magento_Theme::html/header/logo.phtml"/>
        </referenceBlock>
        <referenceBlock name="sidebar.main.account_nav" template="Magento_Customer::account/myca-nav-panel.phtml"/>
        <referenceBlock name="customer_account_navigation" template="Magento_Customer::account/navigation.phtml"/>
        <referenceBlock name="page.main.title" display="false"/>
        <!-- Blocs « Récemment commandé », favoris et comparateur : hors maquette dans l'espace client. -->
        <referenceContainer name="sidebar.additional" remove="true"/>
        <referenceContainer name="content">
            <block name="myca.account.banner" template="Magento_Customer::account/myca-banner.phtml" before="-"/>
        </referenceContainer>

        <!-- Rubriques du menu, dans l'ordre de la maquette. Les rubriques des lots 2 (devis, passeports, fidélité)
             apparaîtront avec leurs modules ; aucun lien vers une page inexistante. -->
        <referenceBlock name="customer-account-navigation-account-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Tableau de bord</argument>
                <argument name="sortOrder" xsi:type="number">250</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-orders-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Mes commandes</argument>
                <argument name="sortOrder" xsi:type="number">240</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-wish-list-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Mes favoris</argument>
                <argument name="sortOrder" xsi:type="number">230</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-product-reviews-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Mes avis &amp; notes</argument>
                <argument name="sortOrder" xsi:type="number">220</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-account-edit-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Mon profil</argument>
                <argument name="sortOrder" xsi:type="number">210</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-address-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Mes adresses</argument>
                <argument name="sortOrder" xsi:type="number">200</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-my-credit-cards-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Mes moyens de paiement</argument>
                <argument name="sortOrder" xsi:type="number">190</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-newsletter-subscriptions-link">
            <arguments>
                <argument name="label" xsi:type="string" translate="true">Mes paramètres</argument>
                <argument name="sortOrder" xsi:type="number">180</argument>
            </arguments>
        </referenceBlock>
        <referenceBlock name="customer-account-navigation-downloadable-products-link" remove="true"/>
        <referenceBlock name="customer-account-navigation-billing-agreements-link" remove="true"/>
    </body>
</page>
