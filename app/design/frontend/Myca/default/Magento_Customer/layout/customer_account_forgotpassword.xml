<?xml version="1.0"?>
<!-- Mot de passe oublié : en-tête MYCA (titre porté par l'en-tête) et carte centrée. -->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <title>Mot de passe oublié</title>
    </head>
    <body>
        <referenceBlock name="page.main.title" remove="true"/>
        <referenceContainer name="content">
            <block name="myca.forgot.header" template="Magento_Customer::login-header.phtml" before="-">
                <arguments>
                    <argument name="title" xsi:type="string" translate="true">Mot de passe oublié ?</argument>
                    <argument name="text" xsi:type="string" translate="true">Pas d’inquiétude : un lien de réinitialisation vous est envoyé par e-mail.</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
