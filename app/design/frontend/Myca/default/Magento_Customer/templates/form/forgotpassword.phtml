<?php
/**
 * Mot de passe oublié (MYCA) : carte centrée, trois étapes, champ e-mail et lien de retour à la connexion.
 * Reprend le gabarit Hyvä (reCAPTCHA, envoi unique) ; seule la présentation change.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\Customer\ForgotPasswordButton;
use Hyva\Theme\ViewModel\ReCaptcha;
use Hyva\Theme\ViewModel\StoreConfig;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Customer\Block\Account\Forgotpassword;
use Magento\Framework\Escaper;

/** @var Forgotpassword $block */
/** @var Escaper $escaper */
/** @var ReCaptcha $recaptcha */
/** @var ForgotPasswordButton $forgotPasswordButtonViewModel */
/** @var ViewModelRegistry $viewModels */

$forgotPasswordButtonViewModel = $viewModels->require(ForgotPasswordButton::class);
$storeConfig = $viewModels->require(StoreConfig::class);
$isAutocompleteEnabled = $storeConfig->getStoreConfig('customer/password/autocomplete_on_storefront');

$formId = 'user_forgotpassword';
$icons = $viewModels->require(SvgIcons::class);
$steps = [
    ['mail', __('Votre e-mail')],
    ['send', __('Le lien reçu')],
    ['key', __('Nouveau mot de passe')],
];

// Do not replace this with $viewModels->require(ReCaptcha::class); that might break the dependency
// on the Magento_ReCaptchaCustomer module
$recaptcha = $block->getData('viewModelRecaptcha');
?>
<div class="myca-forgot">
    <div class="myca-login-card">
        <form action="<?= $escaper->escapeUrl($block->getUrl('*/*/forgotpasswordpost')) ?>"
              method="post"
              id="<?= $escaper->escapeHtmlAttr($formId) ?>"
              class="flex grow flex-col"
              x-data="initPasswordForm()"
              @submit.prevent="submitForm();">
            <?= $block->getBlockHtml('formkey') ?>
            <input type="hidden" name="formId" value="<?= $escaper->escapeHtmlAttr($formId) ?>">
            <?= $block->getChildHtml('form_fields_before') ?>
            <?= $recaptcha ? $recaptcha->getInputHtml(ReCaptcha::RECAPTCHA_FORM_ID_CUSTOMER_FORGOT_PASSWORD) : '' ?>
            <fieldset class="flex grow flex-col gap-4">
                <legend class="myca-login-title">
                    <span class="myca-login-icon myca-forgot-icon" aria-hidden="true"></span>
                    <span>
                        <span class="block"><?= $escaper->escapeHtml(__('Réinitialiser le mot de passe')) ?></span>
                        <span class="block font-sans text-sm font-normal text-fg-secondary"><?= $escaper->escapeHtml(__('Saisissez l’adresse e-mail de votre compte : nous vous envoyons un lien pour en choisir un nouveau.')) ?></span>
                    </span>
                </legend>

                <ol class="myca-forgot-steps" aria-label="<?= $escaper->escapeHtmlAttr(__('Étapes')) ?>">
                    <?php foreach ($steps as $index => [$icon, $label]): ?>
                        <li class="<?= $index === 0 ? 'is-current' : '' ?>">
                            <span><?= $icons->renderHtml($icon, '', 16, 16, ['aria-hidden' => 'true']) ?></span>
                            <?= $escaper->escapeHtml($label) ?>
                        </li>
                    <?php endforeach ?>
                </ol>

                <div class="field email required">
                    <label for="email_address" class="myca-field-label"><?= $escaper->escapeHtml(__('Adresse e-mail')) ?></label>
                    <input type="email"
                           name="email"
                           id="email_address"
                           class="myca-field w-full"
                           autocomplete="<?= $isAutocompleteEnabled ? 'email' : 'off' ?>"
                           placeholder="<?= $escaper->escapeHtmlAttr(__('vous@exemple.com')) ?>"
                           required
                           value="<?= $escaper->escapeHtmlAttr($block->getEmailValue()) ?>">
                </div>
                <?= $block->getChildHtml('form_additional_info') ?>
                <?= $recaptcha ? $recaptcha->getLegalNoticeHtml(ReCaptcha::RECAPTCHA_FORM_ID_CUSTOMER_FORGOT_PASSWORD) : '' ?>

                <button type="submit" class="myca-btn myca-btn-primary min-h-12 w-full text-base disabled:opacity-75"
                    <?php if ($forgotPasswordButtonViewModel->disabled()): ?> disabled data-recaptcha-btn<?php endif; ?>
                >
                    <?= $icons->renderHtml('send', '', 18, 18, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Recevoir le lien')) ?>
                </button>
                <a class="myca-forgot-back" href="<?= $escaper->escapeUrl($block->getLoginUrl()) ?>">
                    <?= $icons->renderHtml('chevron-right', 'rotate-180', 16, 16, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Retour à la connexion')) ?>
                </a>
            </fieldset>
        </form>
        <script>
            function initPasswordForm() {
                return {
                    errors: 0,
                    hasCaptchaToken: 0,
                    isSubmitting: false,
                    submitForm() {
                        if (this.isSubmitting) return;

                        // Do not rename $form, the variable is expected to be declared in the recaptcha output
                        const $form = document.querySelector('#<?= $escaper->escapeJs($formId) ?>');
                        <?= $recaptcha ? $recaptcha->getValidationJsHtml(ReCaptcha::RECAPTCHA_FORM_ID_CUSTOMER_FORGOT_PASSWORD) : '' ?>

                        if (this.errors === 0) {
                            this.isSubmitting = true;
                            $form.querySelector('[type="submit"]')?.setAttribute('disabled', 'disabled');
                            $form.submit();
                        }
                    }
                }
            }
        </script>
    </div>
    <p class="myca-forgot-help">
        <?= $icons->renderHtml('info', 'mt-0.5 shrink-0', 18, 18, ['aria-hidden' => 'true']) ?>
        <span>
            <?= $escaper->escapeHtml(__('Pas d’e-mail après quelques minutes ? Vérifiez vos courriers indésirables, ou')) ?>
            <a href="<?= $escaper->escapeUrl($block->getUrl('contact')) ?>"><?= $escaper->escapeHtml(__('contactez-nous')) ?></a>.
        </span>
    </p>
</div>
