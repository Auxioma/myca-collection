/** @var Escaper $escaper */
/** @var Template $block */
/** @var HyvaCsp $hyvaCsp */
/** @var ViewModelRegistry $viewModels */

$icons = $viewModels->require(SvgIcons::class);
/** @var SearchHelper $helper */
$helper = $this->helper(SearchHelper::class);
/** @var SearchSuggestions $suggestions */
$suggestions = $viewModels->require(SearchSuggestions::class);
$popular = $suggestions->getPopularTerms(6);
$shortcuts = [
    [__('Polos'), 'polos.html'],
    [__('Tee-shirts'), 'tee-shirts.html'],
    [__('Casquettes'), 'casquettes.html'],
    [__('MYCA Signature'), 'myca-signature.html'],
    [__('Toutes les collections'), 'collections.html'],
];
?>
<script>
    function initMycaSearch() {
        return {
            minLength: <?= (int) max(2, (int) $helper->getMinQueryLength()) ?>,
            query: '',
            open: false,
            loading: false,
            results: { products: [], categories: [], terms: [] },
            active: -1,
            controller: null,
            cache: {},
            init() {
                this.query = this.$refs.input.value;
            },
            hasResults() {
                return this.results.products.length + this.results.categories.length + this.results.terms.length > 0;
            },
            typing() {
                return this.query.trim().length >= this.minLength;
            },
            onInput() {
                this.$refs.input.setCustomValidity('');
                this.active = -1;
                this.open = true;
                const term = this.query.trim();
                if (term.length < this.minLength) {
                    this.results = { products: [], categories: [], terms: [] };
                    return;
                }
                if (this.cache[term]) {
                    this.results = this.cache[term];
                    return;
                }
                this.controller?.abort();
                this.controller = new AbortController();
                this.loading = true;
                fetch(window.BASE_URL + 'recherche-apercu/suggest?' + new URLSearchParams({ q: term }), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    signal: this.controller.signal
                })
                    .then((response) => response.json())
                    .then((data) => {
                        this.cache[term] = data;
                        if (this.query.trim() === term) {
                            this.results = data;
                        }
                    })
                    .catch(() => {})
                    .finally(() => { this.loading = false; });
            },
            options() {
                return Array.from(this.$refs.panel?.querySelectorAll('[data-option]') || []).filter((el) => el.offsetParent !== null);
            },
            move(step) {
                if (!this.open) {
                    this.open = true;
                    return;
                }
                const items = this.options();
                if (!items.length) {
                    return;
                }
                this.active = (this.active + step + items.length) % items.length;
                items[this.active].scrollIntoView({ block: 'nearest' });
            },
            isActive(el) {
                return this.active >= 0 && this.options().indexOf(el) === this.active;
            },
            activeId() {
                const item = this.options()[this.active];
                return item ? item.id : '';
            },
            submit() {
                const item = this.options()[this.active];
                if (item && this.open) {
                    item.click();
                    return;
                }
                const term = this.query.trim();
                if (term.length < <?= (int) $helper->getMinQueryLength() ?>) {
                    this.$refs.input.setCustomValidity('<?= $escaper->escapeJs(__('Saisissez au moins %1 caractères.', (int) $helper->getMinQueryLength())) ?>');
                    this.$refs.input.reportValidity();
                    return;
                }
                this.$refs.form.submit();
            },
            searchTerm(term) {
                this.query = term;
                this.$nextTick(() => this.$refs.form.submit());
            },
            close() {
                this.open = false;
                this.active = -1;
            },
            // Met en gras la partie qui correspond à la saisie (texte échappé avant mise en forme)
            highlight(text) {
                const escape = (value) => value.replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
                const term = this.query.trim();
                if (!term) {
                    return escape(text);
                }
                const pattern = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'ig');
                return text.split(pattern).map((part, i) => i % 2 ? '<mark>' + escape(part) + '</mark>' : escape(part)).join('');
            },
            // Le panneau de l'en-tête devient visible juste après l'événement : focus dès qu'il est affiché
            focusAfterOpen(attempt = 0) {
                const input = this.$refs.input;
                if (input.offsetParent === null && attempt < 20) {
                    requestAnimationFrame(() => this.focusAfterOpen(attempt + 1));
                    return;
                }
                input.focus();
                input.select();
                this.open = true;
            }
        };
    }

    window.addEventListener('alpine:init', () => Alpine.data('initMycaSearch', initMycaSearch), { once: true });
</script>
<?php $hyvaCsp->registerInlineScript() ?>
