<?php
/**
 * Recherche de l'en-tête avec autocomplétion : au focus, recherches populaires et raccourcis ; pendant la saisie,
 * produits (image, prix), collections et recherches proches (Myca_Catalog : /recherche-apercu/suggest).
 * Clavier : flèches pour parcourir, Entrée pour ouvrir, Échap pour fermer. Sans script, le formulaire reste un
 * simple champ de recherche.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\HyvaCsp;
use Hyva\Theme\ViewModel\SvgIcons;
