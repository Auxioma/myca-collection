$socials = [
    'facebook' => __('Facebook'),
    'instagram' => __('Instagram'),
    'youtube' => __('YouTube'),
    'linkedin' => __('LinkedIn'),
    'tiktok' => __('TikTok'),
];

$legalLinks = [
    [__('Mentions légales'), 'mentions-legales'],
    [__('Conditions générales de vente'), 'cgv'],
    [__('CGU'), 'cgu'],
    [__('Politique de confidentialité'), 'confidentialite'],
    [__('Cookies'), 'cookies'],
    [__('Plan du site'), 'plan-du-site'],
];

$socialList = static function () use ($socials, $privacy, $icons, $escaper): string {
    $html = '';
    foreach ($socials as $icon => $label) {
        $url = $privacy->getSocialUrl($icon);
        $svg = $icons->renderHtml($icon, '', 22, 22, ['aria-hidden' => 'true']);
        $html .= $url
            ? '<li><a href="' . $escaper->escapeUrl($url) . '" target="_blank" rel="noopener" '
                . 'class="inline-flex size-11 items-center justify-center rounded-full hover:bg-white/10 md:size-9" aria-label="'
                . $escaper->escapeHtmlAttr(__('%1 (nouvel onglet)', $label)) . '">' . $svg . '</a></li>'
            : '<li><span class="inline-flex size-11 items-center justify-center opacity-60 md:size-9" role="img" aria-label="'
                . $escaper->escapeHtmlAttr($label) . '">' . $svg . '</span></li>';
    }

    return $html;
};
$divider = 'xl:border-s xl:border-white/25 xl:ps-6 2xl:ps-8';
