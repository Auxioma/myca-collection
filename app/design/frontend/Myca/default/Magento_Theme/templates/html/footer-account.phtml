<?php
/**
 * Pied de page de l'espace client (Figma « Pied de page/Client B2C ») : logo, liens légaux, tricolore.
 */

declare(strict_types=1);

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;

/** @var Template $block */
/** @var Escaper $escaper */

$links = [
    [__('CGV'), 'cgv'],
    [__('CGU'), 'cgu'],
    [__('Politique de confidentialité'), 'confidentialite'],
    [__('Cookies'), 'cookies'],
    [__('Mentions légales'), 'mentions-legales'],
    [__('Aide / FAQ'), 'faq'],
    [__('Contact'), 'contact'],
];
?>
<footer class="bg-shell text-white">
    <div class="flex flex-col gap-4 px-4 py-4 md:px-6 lg:flex-row lg:items-center lg:gap-7">
        <?= $block->getChildHtml('myca.account.footer.logo') ?>
        <span class="hidden h-6 w-px bg-white lg:block" aria-hidden="true"></span>
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-[13px] leading-[18px]">
            <?php foreach ($links as $index => [$label, $path]): ?>
                <?php if ($index > 0): ?>
                    <li class="text-xs" aria-hidden="true">|</li>
                <?php endif ?>
                <li><a class="block py-2 hover:underline lg:py-0" href="<?= $escaper->escapeUrl($block->getUrl('', ['_direct' => $path])) ?>"><?= $escaper->escapeHtml($label) ?></a></li>
            <?php endforeach ?>
        </ul>
        <div class="flex items-center gap-4 lg:ms-auto">
            <div class="flex" aria-hidden="true">
                <span class="h-2.5 w-10 bg-flag-blue"></span>
                <span class="h-2.5 w-10 bg-white"></span>
                <span class="h-2.5 w-10 bg-brand-red"></span>
            </div>
            <p class="text-[13px] leading-[18px]"><?= $escaper->escapeHtml(__('Espace Client MYCA © %1', date('Y'))) ?></p>
        </div>
    </div>
</footer>
