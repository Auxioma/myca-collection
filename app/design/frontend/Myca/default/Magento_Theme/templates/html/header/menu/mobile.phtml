    >
        <div class="myca-drawer-head bg-shell text-white">
            <div class="flex justify-between items-center gap-2 py-2 ps-4 pe-2">
                <a href="<?= $escaper->escapeUrl($block->getBaseUrl()) ?>" class="flex flex-col leading-none" aria-label="<?= $escaper->escapeHtmlAttr(__('MYCA, retour à l’accueil')) ?>">
                    <span class="font-logo text-2xl">MYCA<sup class="text-[10px]">®</sup></span>
                    <span class="mt-1 text-[8px] font-semibold tracking-[0.3em] text-white/70 uppercase"><?= $escaper->escapeHtml(__('L’élégance sportive')) ?></span>
