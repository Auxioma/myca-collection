                    <?php endforeach; ?>
                </ul>
            </nav>
            <div class="myca-drawer-shortcuts">
                <p><?= $escaper->escapeHtml(__('Mon espace')) ?></p>
                <ul>
                    <?php foreach ($shortcuts as [$icon, $label, $shortcutPath]): ?>
                        <li>
                            <a href="<?= $escaper->escapeUrl($block->getUrl('', ['_direct' => $shortcutPath])) ?>">
