                                        <li data-level="1">
                                            <a
                                                href="<?= $escaper->escapeUrl($subMenuItem['url']) ?>"
                                                class="<?= $escaper->escapeHtmlAttr($itemClasses) ?>"
                                            >
                                                <span class="ms-7"><?= $escaper->escapeHtml($subMenuItem['name']) ?></span>
