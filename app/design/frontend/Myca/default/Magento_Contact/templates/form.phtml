    <script>
        function initContactForm() {
            return {
                errors: 0,
                hasCaptchaToken: 0,
                submitForm() {
                    // Ne pas renommer $form : la variable est attendue par le code reCAPTCHA
                    const $form = document.querySelector('#<?= $escaper->escapeJs($formId) ?>');
                    <?= $recaptcha ? $recaptcha->getValidationJsHtml(ReCaptcha::RECAPTCHA_FORM_ID_CONTACT) : '' ?>

                    if (this.errors === 0) {
                        // Sujet et n° de commande ajoutés en tête du message (Magento n'envoie que ce champ)
                        const subject = this.$refs.subject.value.trim();
                        const order = this.$refs.order.value.trim();
                        const comment = $form.querySelector('#comment');
                        const lines = [];
                        if (subject) {
                            lines.push('<?= $escaper->escapeJs(__('Sujet')) ?> : ' + subject);
                        }
                        if (order) {
                            lines.push('<?= $escaper->escapeJs(__('Commande')) ?> : ' + order);
                        }
                        if (lines.length && !comment.value.startsWith(lines[0])) {
                            comment.value = lines.join('\n') + '\n\n' + comment.value;
                        }
                        $form.submit();
                    }
                }
            }
        }
    </script>

