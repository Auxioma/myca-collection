<?php
/**
 * M23 — Retours & SAV (partenaire) : indicateurs, filtres, tableau des demandes de la boutique, détail, suivi,
 * résumé du traitement et actions rapides. Seules les demandes de la boutique active sont lues.
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Myca\Partner\ViewModel\PartnerSpace;
use Myca\Rma\Model\ReturnPolicy;
use Myca\Rma\Model\Rma;
use Myca\Rma\ViewModel\Returns;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$icons = $viewModels->require(SvgIcons::class);
/** @var Returns $returns */
$returns = $viewModels->require(Returns::class);
/** @var PartnerSpace $space */
$space = $viewModels->require(PartnerSpace::class);
$request = $block->getRequest();

$rmas = $returns->getPartnerRmas();
$filters = [
    'toutes' => ['layers', __('Toutes les demandes')],
    'retours' => ['refresh', __('Retours')],
    'echanges' => ['swap', __('Échanges')],
    'sav' => ['wrench', __('SAV')],
    'en-cours' => ['clock', __('En cours')],
    'cloturees' => ['check-circle', __('Clôturées')],
];
$typeByFilter = ['retours' => ReturnPolicy::TYPE_RETURN, 'echanges' => ReturnPolicy::TYPE_EXCHANGE, 'sav' => ReturnPolicy::TYPE_WARRANTY];
$matchesFilter = static function (Rma $rma, string $filter) use ($returns, $typeByFilter): bool {
    return match ($filter) {
        'toutes' => true,
        'en-cours' => $returns->isOpen($rma),
        'cloturees' => !$returns->isOpen($rma),
        default => $rma->getType() === ($typeByFilter[$filter] ?? null),
    };
};
$periods = ['30' => __('30 derniers jours'), '90' => __('3 derniers mois'), '365' => __('12 derniers mois'), 'tout' => __('Toute la période')];

$filter = (string) $request->getParam('filtre', 'toutes');
$filter = isset($filters[$filter]) ? $filter : 'toutes';
$period = (string) $request->getParam('periode', 'tout');
$period = isset($periods[$period]) ? $period : 'tout';
$query = trim((string) $request->getParam('q'));
$since = $period === 'tout' ? 0 : strtotime('-' . (int) $period . ' days');

$itemsByRma = [];
foreach ($rmas as $rma) {
    $itemsByRma[(int) $rma->getId()] = $returns->getItems($rma);
}
$matchesSearch = static function (Rma $rma) use ($query, $itemsByRma): bool {
    if ($query === '') {
        return true;
    }
    $haystack = [$rma->getIncrementId(), (string) $rma->getData('order_increment_id')];
    foreach ($itemsByRma[(int) $rma->getId()] as $item) {
        $haystack[] = (string) $item['name'];
        $haystack[] = (string) $item['sku'];
    }

    return mb_stripos(implode(' ', $haystack), $query) !== false;
};
$inScope = array_values(array_filter(
    $rmas,
    static fn (Rma $rma) => strtotime((string) $rma->getData('created_at')) >= $since && $matchesSearch($rma)
));
$visible = array_values(array_filter($inScope, static fn (Rma $rma) => $matchesFilter($rma, $filter)));

$selectedId = (int) $request->getParam('demande');
$selected = null;
foreach ($visible as $rma) {
    if ($selected === null || (int) $rma->getId() === $selectedId) {
        $selected = $rma;
    }
}
// Une demande ouverte par lien direct reste affichée même si les filtres la masquent.
if ($selectedId > 0 && ($selected === null || (int) $selected->getId() !== $selectedId)) {
    foreach ($rmas as $rma) {
        if ((int) $rma->getId() === $selectedId) {
            $selected = $rma;
        }
    }
}
$baseQuery = array_filter(['q' => $query, 'periode' => $period === 'tout' ? null : $period]);

$count = static fn (string $code) => count(array_filter($rmas, static fn (Rma $rma) => $matchesFilter($rma, $code)));
$closed = $count('cloturees');
$credited = array_sum(array_map(static fn (Rma $rma) => (float) $rma->getData('refunded_amount'), $rmas));
$kpis = [
    ['icon' => 'refresh', 'label' => __('Demandes totales'), 'value' => (string) count($rmas)],
    ['icon' => 'box', 'label' => __('Retours'), 'value' => (string) $count('retours')],
    ['icon' => 'swap', 'label' => __('Échanges'), 'value' => (string) $count('echanges')],
    ['icon' => 'wrench', 'label' => __('SAV / garantie'), 'value' => (string) $count('sav')],
    ['icon' => 'clock', 'label' => __('En cours'), 'value' => (string) $count('en-cours')],
    ['icon' => 'check-circle', 'label' => __('Clôturées'), 'value' => (string) $closed, 'detail' => $rmas ? sprintf('%d %%', round($closed / count($rmas) * 100)) : null],
    ['icon' => 'euro', 'label' => __('Avoirs MYCA'), 'value' => $space->formatPrice($credited)],
];
?>
<div class="flex flex-col gap-4">
    <?= $block->getLayout()->createBlock(Template::class)->setTemplate('Myca_Partner::partials/kpis.phtml')->setData('kpis', $kpis)->toHtml() ?>

    <nav aria-label="<?= $escaper->escapeHtmlAttr(__('Filtrer les demandes')) ?>">
