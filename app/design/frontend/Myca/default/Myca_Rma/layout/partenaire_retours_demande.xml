<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="myca_partner_space"/>
    <body>
        <referenceBlock name="myca.partner.banner">
            <arguments>
                <argument name="kicker" xsi:type="string" translate="true">RETOURS &amp; SAV</argument>
                <argument name="title" xsi:type="string" translate="true">Nouvelle demande</argument>
                <argument name="subtitle" xsi:type="string" translate="true">Retour, échange ou SAV d’un article de votre commande.</argument>
            </arguments>
        </referenceBlock>
        <referenceContainer name="content">
            <block name="myca.partner.page" template="Myca_Rma::request-form.phtml" after="myca.partner.banner" cacheable="false">
                <arguments>
                    <argument name="partner" xsi:type="boolean">true</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
