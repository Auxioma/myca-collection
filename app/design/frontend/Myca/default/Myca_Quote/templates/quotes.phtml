                        <?php endif ?>
                        <dl class="grid flex-1 grid-cols-[auto_1fr] content-start gap-x-3 gap-y-2 myca-caption lg:min-w-[200px]">
                            <dt class="text-fg-secondary"><?= $escaper->escapeHtml(__('Devis du')) ?></dt>
                            <dd class="text-right font-semibold whitespace-nowrap text-fg"><?= $escaper->escapeHtml($block->formatDate((string) $selected->getData('created_at'), IntlDateFormatter::MEDIUM)) ?></dd>
                            <dt class="text-fg-secondary"><?= $escaper->escapeHtml(__('Statut')) ?></dt>
                            <dd class="text-right"><span class="myca-badge myca-badge-<?= $escaper->escapeHtmlAttr($status['tone']) ?>"><?= $escaper->escapeHtml($status['label']) ?></span></dd>
                            <dt class="text-fg-secondary"><?= $escaper->escapeHtml(__('Validité')) ?></dt>
                            <dd class="text-right font-semibold whitespace-nowrap text-fg"><?= $escaper->escapeHtml($quotes->formatDate($selected->getData('valid_until') ? (string) $selected->getData('valid_until') : null)) ?></dd>
                            <?php if ($selected->getData('order_increment_id')): ?>
                                <dt class="text-fg-secondary"><?= $escaper->escapeHtml(__('Commande')) ?></dt>
                                <dd class="text-right font-semibold text-fg"><?= $escaper->escapeHtml((string) $selected->getData('order_increment_id')) ?></dd>
                            <?php endif ?>
                        </dl>
                    </div>
                    <div class="flex min-w-0 flex-col gap-2">
                        <table class="w-full myca-caption">
                            <thead>
                                <tr class="bg-surface-subtle text-left myca-caption-strong text-fg-secondary">
                                    <th scope="col" class="px-2 py-1.5"><?= $escaper->escapeHtml(__('Article')) ?></th>
                                    <th scope="col" class="px-2 py-1.5 text-right"><?= $escaper->escapeHtml(__('Qté')) ?></th>
                                    <th scope="col" class="px-2 py-1.5 text-right"><?= $escaper->escapeHtml(__('PU TTC')) ?></th>
                                    <th scope="col" class="px-2 py-1.5 text-right"><?= $escaper->escapeHtml(__('Total')) ?></th>
                                </tr>
                            </thead>
                            <tbody>
                                <?php foreach ($items as $item): ?>
                                    <?php $unit = $item['unit_price_incl_tax'] === null ? null : (float) $item['unit_price_incl_tax']; ?>
                                    <tr class="border-b border-line">
                                        <td class="px-2 py-2 text-fg"><?= $escaper->escapeHtml((string) $item['name']) ?></td>
                                        <td class="px-2 py-2 text-right text-fg"><?= (float) $item['qty'] ?></td>
                                        <td class="px-2 py-2 text-right whitespace-nowrap text-fg"><?= $escaper->escapeHtml($quotes->formatPrice($unit)) ?></td>
                                        <td class="px-2 py-2 text-right whitespace-nowrap text-fg"><?= $escaper->escapeHtml($quotes->formatPrice($unit === null ? null : $unit * (float) $item['qty'])) ?></td>
