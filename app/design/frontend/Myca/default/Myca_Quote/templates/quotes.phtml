<?php
/**
 * M30 — Mes devis : indicateurs, filtres, tableau des devis, détail (articles, HT / TVA / TTC), suivi et actions.
 * Accepter un devis n'est pas une facture : la commande et le paiement suivent « Transformer en commande ».
 */

declare(strict_types=1);

use Hyva\Theme\Model\ViewModelRegistry;
use Hyva\Theme\ViewModel\SvgIcons;
use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Myca\Quote\Model\Quote;
use Myca\Quote\ViewModel\Quotes;

/** @var Template $block */
/** @var Escaper $escaper */
/** @var ViewModelRegistry $viewModels */

$icons = $viewModels->require(SvgIcons::class);
/** @var Quotes $quotes */
$quotes = $viewModels->require(Quotes::class);
$request = $block->getRequest();
$all = $quotes->getQuotes();
$counts = $quotes->getCounts();
$filter = (string) $request->getParam('filtre', 'tous');
$filter = isset($counts[$filter]) ? $filter : 'tous';
$query = trim((string) $request->getParam('q'));
$visible = array_values(array_filter($all, static function (Quote $quote) use ($quotes, $filter, $query): bool {
    if (!$quotes->matches($quote, $filter)) {
        return false;
    }
    if ($query === '') {
        return true;
    }
    $haystack = [$quote->getIncrementId()];
    foreach ($quotes->getItems($quote) as $item) {
        $haystack[] = (string) $item['name'];
        $haystack[] = (string) $item['sku'];
    }

    return mb_stripos(implode(' ', $haystack), $query) !== false;
}));
$selectedId = (int) $request->getParam('devis');
$selected = null;
foreach ($all as $quote) {
    if ((int) $quote->getId() === $selectedId) {
        $selected = $quote;
    }
}
$selected ??= $visible[0] ?? null;
$kpis = [
    ['tous', 'file', __('Mes devis')],
    ['en-attente', 'clock', __('En attente')],
    ['acceptes', 'check-circle', __('Acceptés')],
    ['refuses', 'alert', __('Refusés')],
    ['brouillons', 'edit', __('Brouillons')],
];
$actionLabels = [
    'envoyer' => ['send', __('Envoyer la demande'), 'myca-btn-primary'],
    'accepter' => ['check', __('Accepter ce devis'), 'myca-btn-primary'],
    'commander' => ['cart', __('Transformer en commande'), 'myca-btn-primary'],
    'refuser' => ['logout', __('Refuser ce devis'), 'myca-btn-secondary'],
    'annuler' => ['logout', __('Annuler ce devis'), 'myca-btn-outline-accent'],
];
?>
<div class="flex min-w-0 flex-col gap-4">
    <ul class="grid grid-cols-2 gap-3 lg:grid-cols-5" aria-label="<?= $escaper->escapeHtmlAttr(__('Indicateurs')) ?>">
        <?php foreach ($kpis as [$code, $icon, $label]): ?>
            <li>
                <a href="<?= $escaper->escapeUrl($block->getUrl('devis', ['_query' => $code === 'tous' ? [] : ['filtre' => $code]])) ?>"
                   class="myca-card flex h-full items-center gap-3 p-4 shadow-card hover:border-line-strong <?= $code === $filter ? 'border-accent' : '' ?>"
                   <?= $code === $filter ? 'aria-current="page"' : '' ?>>
                    <?= $icons->renderHtml($icon, 'shrink-0 text-icon-kpi', 26, 26, ['aria-hidden' => 'true']) ?>
                    <span class="flex min-w-0 flex-1 flex-col">
                        <span class="myca-caption-strong text-fg-secondary"><?= $escaper->escapeHtml($label) ?></span>
                        <span class="text-[22px] leading-7 font-bold text-fg"><?= (int) $counts[$code] ?></span>
                    </span>
                    <?= $icons->renderHtml('chevron-right', 'shrink-0 text-fg-secondary', 16, 16, ['aria-hidden' => 'true']) ?>
                </a>
            </li>
        <?php endforeach ?>
    </ul>

    <div class="grid gap-3 md:grid-cols-[minmax(0,1fr)_auto] md:items-end">
        <form method="get" action="<?= $escaper->escapeUrl($block->getUrl('devis')) ?>" class="flex gap-2">
            <?php if ($filter !== 'tous'): ?>
                <input type="hidden" name="filtre" value="<?= $escaper->escapeHtmlAttr($filter) ?>">
            <?php endif ?>
            <label for="myca-quote-q" class="sr-only"><?= $escaper->escapeHtml(__('Rechercher un devis')) ?></label>
            <input id="myca-quote-q" type="search" name="q" value="<?= $escaper->escapeHtmlAttr($query) ?>" class="myca-field"
                   placeholder="<?= $escaper->escapeHtmlAttr(__('Rechercher un devis (n°, produit…)')) ?>">
            <button type="submit" class="myca-btn myca-btn-secondary shrink-0" aria-label="<?= $escaper->escapeHtmlAttr(__('Rechercher')) ?>"><?= $icons->renderHtml('search', '', 16, 16, ['aria-hidden' => 'true']) ?></button>
        </form>
        <a href="<?= $escaper->escapeUrl($block->getUrl('checkout/cart', ['_query' => ['devis' => 1]])) ?>" class="myca-btn myca-btn-primary">
            <?= $icons->renderHtml('send', '', 16, 16, ['aria-hidden' => 'true']) ?><?= $escaper->escapeHtml(__('Demander un devis')) ?>
        </a>
    </div>

    <section class="myca-card p-4" aria-labelledby="myca-quotes-table">
        <h2 id="myca-quotes-table" class="sr-only"><?= $escaper->escapeHtml(__('Devis')) ?></h2>
        <?php if ($visible): ?>
            <div class="relative md:overflow-x-auto">
                <table class="w-full myca-body-s">
                    <thead class="hidden md:table-header-group">
                        <tr class="bg-surface-subtle text-left myca-caption-strong text-fg-secondary">
                            <th scope="col" class="px-2.5 py-2"><?= $escaper->escapeHtml(__('N° devis')) ?></th>
                            <th scope="col" class="px-2.5 py-2"><?= $escaper->escapeHtml(__('Date')) ?></th>
                            <th scope="col" class="px-2.5 py-2"><?= $escaper->escapeHtml(__('Articles')) ?></th>
                            <th scope="col" class="px-2.5 py-2 text-right"><?= $escaper->escapeHtml(__('Montant HT')) ?></th>
                            <th scope="col" class="px-2.5 py-2 text-right"><?= $escaper->escapeHtml(__('TVA')) ?></th>
                            <th scope="col" class="px-2.5 py-2 text-right"><?= $escaper->escapeHtml(__('Montant TTC')) ?></th>
                            <th scope="col" class="px-2.5 py-2"><?= $escaper->escapeHtml(__('Statut')) ?></th>
                            <th scope="col" class="px-2.5 py-2"><?= $escaper->escapeHtml(__('Validité')) ?></th>
                            <th scope="col" class="px-2.5 py-2"><span class="sr-only"><?= $escaper->escapeHtml(__('Actions')) ?></span></th>
                        </tr>
                    </thead>
                    <tbody>
                        <?php foreach ($visible as $quote): ?>
                            <?php
                            $status = $quotes->getStatus($quote);
                            $isSelected = $selected && $quote->getId() === $selected->getId();
                            $priced = $quotes->isPriced($quote);
                            ?>
                            <tr class="grid grid-cols-[1fr_auto] gap-x-3 gap-y-1 border-b border-line py-3 md:table-row md:py-0 <?= $isSelected ? 'md:bg-gold-100' : '' ?>">
                                <td class="font-semibold whitespace-nowrap text-fg md:px-2.5 md:py-3"><?= $escaper->escapeHtml($quote->getIncrementId()) ?></td>
                                <td class="whitespace-nowrap text-fg-secondary md:px-2.5 md:py-3 md:text-fg"><?= $escaper->escapeHtml($block->formatDate((string) $quote->getData('created_at'), IntlDateFormatter::MEDIUM)) ?></td>
                                <td class="col-span-2 text-fg md:px-2.5 md:py-3"><?= $escaper->escapeHtml($quotes->getSummary($quote)) ?></td>
                                <td class="hidden whitespace-nowrap text-fg md:table-cell md:px-2.5 md:py-3 md:text-right"><?= $escaper->escapeHtml($priced ? $quotes->formatPrice((float) $quote->getData('subtotal_excl_tax')) : '—') ?></td>
                                <td class="hidden whitespace-nowrap text-fg md:table-cell md:px-2.5 md:py-3 md:text-right"><?= $escaper->escapeHtml($priced ? $quotes->formatPrice((float) $quote->getData('tax_amount')) : '—') ?></td>
