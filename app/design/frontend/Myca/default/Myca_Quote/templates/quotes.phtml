                                <div class="flex justify-between"><dt class="text-fg-secondary"><?= $escaper->escapeHtml(__('TVA')) ?></dt><dd class="font-semibold text-fg"><?= $escaper->escapeHtml($quotes->formatPrice((float) $selected->getData('tax_amount'))) ?></dd></div>
