                                           aria-label="<?= $escaper->escapeHtmlAttr(__('Afficher le devis %1', $quote->getIncrementId())) ?>">
                                            <?= $icons->renderHtml('eye', '', 16, 16, ['aria-hidden' => 'true']) ?>
                                        </a>
                                        <?php if ($quote->getData('pdf_path')): ?>
                                            <a href="<?= $escaper->escapeUrl($block->getUrl('devis/pdf', ['_query' => ['id' => $quote->getId()]])) ?>"
                                               class="inline-flex size-11 items-center justify-center rounded-md text-fg-secondary hover:bg-surface-subtle hover:text-fg md:size-8"
                                               aria-label="<?= $escaper->escapeHtmlAttr(__('Télécharger le devis %1 (PDF)', $quote->getIncrementId())) ?>">
                                                <?= $icons->renderHtml('download', '', 16, 16, ['aria-hidden' => 'true']) ?>
                                            </a>
                                        <?php endif ?>
                                    </span>
                                </td>
                            </tr>
                        <?php endforeach ?>
                    </tbody>
                </table>
            </div>
        <?php elseif ($all): ?>
            <p class="myca-body-s text-fg-secondary"><?= $escaper->escapeHtml(__('Aucun devis ne correspond à ces critères.')) ?></p>
        <?php else: ?>
            <p class="myca-body-s text-fg-secondary"><?= $escaper->escapeHtml(__('Vous n’avez pas encore de devis. Ajoutez les articles et quantités souhaités à votre panier, puis choisissez « Demander un devis ».')) ?></p>
        <?php endif ?>
    </section>

    <?php if ($selected): ?>
        <?php
        $items = $quotes->getItems($selected);
        $status = $quotes->getStatus($selected);
        $priced = $quotes->isPriced($selected);
        $first = reset($items) ?: null;
        ?>
