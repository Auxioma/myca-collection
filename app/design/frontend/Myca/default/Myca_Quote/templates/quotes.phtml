                                <td class="whitespace-nowrap text-fg-secondary md:px-2.5 md:py-3 md:text-fg"><?= $escaper->escapeHtml($quotes->formatDate($quote->getData('valid_until') ? (string) $quote->getData('valid_until') : null)) ?></td>
                                <td class="col-span-2 md:px-2.5 md:py-2">
                                    <span class="flex items-center gap-1">
                                        <a href="<?= $escaper->escapeUrl($block->getUrl('devis', ['_query' => array_filter(['filtre' => $filter === 'tous' ? null : $filter, 'q' => $query ?: null, 'devis' => $quote->getId()])])) ?>"
